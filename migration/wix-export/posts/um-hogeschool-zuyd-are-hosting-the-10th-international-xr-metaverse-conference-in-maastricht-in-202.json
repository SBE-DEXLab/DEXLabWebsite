   "markDefs": [],
   "children": [
    {
     "_type": "span",
     "_key": "k1",
     "text": "We are thrilled to announce that DEXLab will be hosting the 10th International XR-Metaverse Conference (XRM2025) in Maastricht, The Netherlands, from June 25-27, 2025. This prestigious event brings together leading researchers, innovators, and industry professionals in the field of extended reality and metaverse technologies.",
     "marks": []
    }
   ]
  },
  {
   "_type": "image",
   "_key": "k2",
   "_sanityAsset": "image@https://static.wixstatic.com/media/9aa9b6_2a1c6298eb8045abae9da3fb43da4623~mv2.png",
   "alt": ""
  },
  {
   "_type": "block",
   "_key": "k3",
   "style": "normal",
   "markDefs": [],
   "children": [
    {
     "_type": "span",
     "_key": "k4",
     "text": "The conference theme, \"Bridging between realities: transformative, inclusive, and sustainable XR,\" reflects our commitment to advancing XR technologies that positively impact society.",
     "marks": []
    }
   ]
  },
  {
   "_type": "block",
   "_key": "k5",
   "style": "normal",
   "markDefs": [],
   "children": [
    {
