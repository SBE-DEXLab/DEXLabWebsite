---
import Img from '../site/Img.astro'
import Buttons from '../site/Buttons.astro'
import Shader from '../Shader.astro'
import Scribble from '../Scribble.astro'
import {brandify} from '../../lib/site/utils'
import {look, type Theme} from '../../lib/theme'
import type {Img as ImgT, Link} from '../../lib/site/types'

interface Props {
  t: Theme
  heading: string
  eyebrow?: string
  subheading?: string
  image?: ImgT
  buttons?: Link[]
  home?: boolean
  slug?: string
  first?: boolean
}
const {t, heading, eyebrow, subheading, image, buttons, home = false, slug = 'home', first = true} = Astro.props
const k = look(t)
const H = first ? 'h1' : 'h2'
const focus = image?.hotspot ? `${image.hotspot.x * 100}% ${image.hotspot.y * 100}%` : '50% 40%'
// Home heading "DEXLab the Digital Experience Lab" splits into brand line + rest.
const [first1, ...rest] = heading.split(' ')
const restText = rest.join(' ')
const file = (image?.alt || slug).toLowerCase().replace(/[^a-z0-9]+/g, '_').slice(0, 28)
---

{
  t === 'a' && (
    <section class="relative overflow-hidden pt-32 pb-16 md:pt-40 md:pb-24">
      <div class="pointer-events-none absolute -top-40 -right-40 h-[36rem] w-[36rem] rounded-full bg-dex/20 blur-3xl" />
      <div class="pointer-events-none absolute -bottom-52 -left-40 h-[28rem] w-[28rem] rounded-full bg-lab/15 blur-3xl" />
      <div class:list={['relative mx-auto max-w-[1320px] px-5 md:px-8', image?.url && home ? 'grid items-center gap-14 lg:grid-cols-[1.05fr_1fr]' : '']}>
        <div class="reveal">
          <div class="mb-8 flex items-center gap-2" aria-hidden="true">
            <span class="h-3 w-3 rounded-full bg-dex" /><span class="h-3 w-3 rounded-full bg-lab" /><span class="h-3 w-3 rounded-full bg-peach" /><span class="h-3 w-3 rounded-full bg-white" />
          </div>
          {eyebrow && <p class="mb-4 text-sm font-bold uppercase tracking-[0.18em] text-dex">{eyebrow}</p>}
          <H class:list={['display', home ? 'text-[clamp(3.2rem,8vw,7.2rem)]' : 'text-[clamp(2.8rem,6.6vw,5.8rem)]', 'max-w-5xl']}>
            {home && first1 === 'DEXLab' ? (
              <>
                <span set:html={brandify(first1)} />
                <br />
                <span class="relative">
                  {restText}
                  <Scribble kind="underline" class="absolute -bottom-[0.18em] right-0 h-[0.28em] w-[45%]" />
                </span>
              </>
            ) : (
              <span set:html={brandify(heading)} />
            )}
          </H>
          {subheading && <p class="mt-10 max-w-2xl text-lg leading-8 whitespace-pre-line text-white/75">{subheading}</p>}
          <div class="mt-10 flex items-center gap-5">
            <Buttons t={t} buttons={buttons} />
            {buttons?.length ? <Scribble kind="arrow" class="hidden w-24 -rotate-12 md:block" color="#00a2db" /> : null}
          </div>
        </div>
        {image?.url && (
          <div class:list={['reveal relative', home ? '' : 'mt-14']}>
            <Scribble kind="loop" class="absolute -top-10 -left-8 z-10 w-36 md:w-48" />
            <Scribble kind="spark" class="absolute -right-3 -bottom-5 z-10 w-12" color="#00a2db" />
            <figure class:list={['relative overflow-hidden rounded-[2rem] ring-1 ring-white/10 shadow-[0_40px_120px_-30px_rgb(0,162,219,0.45)]', home ? 'rotate-[1.5deg]' : '']}>
              <Img image={image} width={home ? 1200 : 1600} height={home ? 900 : 700} sizes="(min-width: 1320px) 1240px, 100vw" eager class:list={['w-full object-cover', home ? 'aspect-[4/3]' : 'aspect-[16/7]']} style={`object-position:${focus}`} />
            </figure>
          </div>
        )}
      </div>
    </section>
  )
}

{
  t === 'b' && (
    <section class="relative px-3 pt-3">
      <div class:list={['grain relative isolate overflow-hidden rounded-[2.5rem] text-white', home ? 'pt-36 md:pt-44' : 'pt-32 md:pt-40', image?.url ? (home ? 'pb-48 md:pb-64' : 'pb-40 md:pb-52') : 'pb-20 md:pb-28']}>
        <div class="absolute inset-0 -z-10"><Shader colors={['#001c3d', '#00a2db', '#e84e10', '#0a1426']} seed={heading.length % 9} speed={0.8} /></div>
        <div class="absolute inset-0 -z-10 bg-navy/30" />
        <div class="reveal mx-auto max-w-5xl px-5 text-center">
          {eyebrow && <p class="mb-5 text-xs font-bold uppercase tracking-[0.2em] text-white/80">{eyebrow}</p>}
          <H class:list={['display', home ? 'text-[clamp(3rem,8.5vw,7.5rem)]' : 'text-[clamp(2.6rem,6.4vw,5.4rem)]']}>
            <span set:html={brandify(heading).replace('brand-dex', 'brand-dex !text-white')} />
          </H>
          {subheading && <p class="mx-auto mt-8 max-w-3xl text-lg leading-8 whitespace-pre-line text-white/85">{subheading}</p>}
          <Buttons t={t} s="deep" buttons={buttons} center class="mt-10" />
        </div>
      </div>
      {image?.url && (
        <figure class:list={['reveal relative z-10 mx-auto max-w-[1100px] px-4', home ? '-mt-36 md:-mt-48' : '-mt-28 md:-mt-36']}>
          <Img image={image} width={1600} height={home ? 900 : 640} sizes="(min-width: 1100px) 1100px, 100vw" eager class:list={['w-full rounded-[2rem] object-cover shadow-[0_50px_120px_-40px_rgb(0,28,61,0.55)] ring-8 ring-white', home ? 'aspect-[16/9]' : 'aspect-[5/2]']} style={`object-position:${focus}`} />
        </figure>
      )}
    </section>
  )
}

{
  t === 'c' && (
    <section class="term-grid relative pt-28 pb-16 md:pt-36 md:pb-24">
      <div class:list={['mx-auto grid max-w-[1320px] gap-8 px-5 md:px-8', image?.url ? 'lg:grid-cols-[1.15fr_1fr]' : '']}>
        <div class="reveal overflow-hidden rounded-lg bg-[#0b1324]/95 ring-1 ring-dex/30 shadow-[0_0_80px_-20px_rgb(0,162,219,0.35)]">
          <div class="flex items-center gap-2 border-b border-dex/20 bg-[#0e1830] px-4 py-3 font-mono text-xs text-white/50">
            <span class="h-3 w-3 rounded-full bg-lab" /><span class="h-3 w-3 rounded-full bg-peach" /><span class="h-3 w-3 rounded-full bg-dex" />
            <span class="ml-3">dexlab@maastricht: ~/{slug === 'home' ? '' : slug}</span>
          </div>
          <div class="p-6 md:p-10">
            <p class="font-mono text-sm text-dex"><span class="text-lab">$</span> {home ? 'whoami' : `cat ${slug}.md`}</p>
            {eyebrow && <p class="mt-6 font-mono text-xs uppercase tracking-[0.2em] text-white/50">{eyebrow}</p>}
            <H class:list={['caret mt-5 font-mono font-bold tracking-[-0.04em] leading-[1.02]', home ? 'text-[clamp(2.4rem,6vw,5rem)]' : 'text-[clamp(2.1rem,5vw,4.2rem)]']}>
              <span set:html={brandify(heading)} />
            </H>
            {subheading && (
              <>
                <p class="mt-10 font-mono text-sm text-dex"><span class="text-lab">$</span> cat README.md</p>
                <p class="mt-3 max-w-3xl font-mono text-[0.95rem] leading-7 whitespace-pre-line text-white/75">{subheading}</p>
              </>
            )}
            {buttons?.length ? <Buttons t={t} buttons={buttons} class="mt-10" /> : null}
          </div>
        </div>
        {image?.url && (
          <figure class="reveal relative overflow-hidden rounded-lg ring-1 ring-dex/30">
            <Img image={image} width={1100} height={900} sizes="(min-width: 1024px) 560px, 100vw" eager class="duotone h-full min-h-[18rem] w-full object-cover" style={`object-position:${focus}`} />
            <div class="pointer-events-none absolute inset-0 bg-dex/25 mix-blend-color" />
            <figcaption class="absolute inset-x-0 bottom-0 flex justify-between bg-[#070b14]/85 px-4 py-2 font-mono text-[0.7rem] text-white/60">
              <span>{file}.jpg</span>
              <span>{image.dims ? `${image.dims.width}×${image.dims.height}` : ''}</span>
            </figcaption>
          </figure>
        )}
      </div>
    </section>
  )
}
