---
import Img from '../site/Img.astro'
import Buttons from '../site/Buttons.astro'
import Shader from '../Shader.astro'
import Scribble from '../Scribble.astro'
import Synapse from '../Synapse.astro'
import {brandify} from '../../lib/site/utils'
import {look, splitTwoTone, type Theme} from '../../lib/theme'
import type {Img as ImgT, Link} from '../../lib/site/types'

interface Props {
  t: Theme
  heading: string
  eyebrow?: string
  subheading?: string
  image?: ImgT
  buttons?: Link[]
  home?: boolean
  slug?: string
  first?: boolean
}
const {t, heading, eyebrow, subheading, image, buttons, home = false, slug = 'home', first = true} = Astro.props
const k = look(t)
const H = first ? 'h1' : 'h2'
// Home heading "DEXLab the Digital Experience Lab" splits into brand line + rest.
const [first1, ...rest] = heading.split(' ')
const restText = rest.join(' ')
// Version D: brand line on its own, then a grey lead-in and a dark remainder.
const brandLine = home && first1 === 'DEXLab'
const [grey, dark] = splitTwoTone(brandLine ? restText : heading)
const file = (image?.alt || slug).toLowerCase().replace(/[^a-z0-9]+/g, '_').slice(0, 28)
---

{
  t === 'a' && (
    <section class="relative overflow-hidden pt-32 pb-16 md:pt-40 md:pb-24">
      <div class="pointer-events-none absolute -top-40 -right-40 h-[36rem] w-[36rem] rounded-full bg-dex/20 blur-3xl" />
      <div class="pointer-events-none absolute -bottom-52 -left-40 h-[28rem] w-[28rem] rounded-full bg-lab/15 blur-3xl" />
      <div class:list={['relative mx-auto max-w-[1320px] px-5 md:px-8', image?.url && home ? 'grid items-center gap-14 lg:grid-cols-[1.05fr_1fr]' : '']}>
        <div class="reveal">
          <div class="mb-8 flex items-center gap-2" aria-hidden="true">
            <span class="h-3 w-3 rounded-full bg-dex" /><span class="h-3 w-3 rounded-full bg-lab" /><span class="h-3 w-3 rounded-full bg-peach" /><span class="h-3 w-3 rounded-full bg-white" />
          </div>
          {eyebrow && <p class="mb-4 text-sm font-bold uppercase tracking-[0.18em] text-dex">{eyebrow}</p>}
          <H class:list={['display', home ? 'text-[clamp(3.2rem,8vw,7.2rem)]' : 'text-[clamp(2.8rem,6.6vw,5.8rem)]', 'max-w-5xl']}>
            {home && first1 === 'DEXLab' ? (
              <>
                <span set:html={brandify(first1)} />
                <br />
                <span class="relative">
                  {restText}
                  <Scribble kind="underline" class="absolute -bottom-[0.18em] right-0 h-[0.28em] w-[45%]" />
                </span>
              </>
            ) : (
              <span set:html={brandify(heading)} />
            )}
          </H>
          {subheading && <p class="mt-10 max-w-2xl text-lg leading-8 whitespace-pre-line text-white/75">{subheading}</p>}
          <div class="mt-10 flex items-center gap-5">
            <Buttons t={t} buttons={buttons} />
            {buttons?.length ? <Scribble kind="arrow" class="hidden w-24 -rotate-12 md:block" color="#00a2db" /> : null}
          </div>
        </div>
        {image?.url && (
          <div class:list={['reveal relative', home ? '' : 'mt-14']}>
            <Scribble kind="loop" class="absolute -top-10 -left-8 z-10 w-36 md:w-48" />
            <Scribble kind="spark" class="absolute -right-3 -bottom-5 z-10 w-12" color="#00a2db" />
            <figure class:list={['relative overflow-hidden rounded-[2rem] ring-1 ring-white/10 shadow-[0_40px_120px_-30px_rgb(0,162,219,0.45)]', home ? 'rotate-[1.5deg]' : '']}>
              <Img image={image} width={home ? 1200 : 1600} fit="max" sizes="(min-width: 1320px) 1240px, 100vw" eager class="h-auto w-full" />
            </figure>
          </div>
        )}
      </div>
    </section>
  )
}

{
  t === 'b' && (
    <section class="relative px-3 pt-3">
      <div class:list={['grain relative isolate overflow-hidden rounded-[2.5rem] text-white', home ? 'pt-36 md:pt-44' : 'pt-32 md:pt-40', image?.url ? (home ? 'pb-48 md:pb-64' : 'pb-40 md:pb-52') : 'pb-20 md:pb-28']}>
        <div class="absolute inset-0 -z-10"><Shader colors={['#001c3d', '#00a2db', '#e84e10', '#0a1426']} seed={heading.length % 9} speed={0.8} /></div>
        <div class="absolute inset-0 -z-10 bg-navy/30" />
        <div class="reveal mx-auto max-w-5xl px-5 text-center">
          {eyebrow && <p class="mb-5 text-xs font-bold uppercase tracking-[0.2em] text-white/80">{eyebrow}</p>}
          <H class:list={['display', home ? 'text-[clamp(3rem,8.5vw,7.5rem)]' : 'text-[clamp(2.6rem,6.4vw,5.4rem)]']}>
            <span set:html={brandify(heading)} />
          </H>
          {subheading && <p class="mx-auto mt-8 max-w-3xl text-lg leading-8 whitespace-pre-line text-white/85">{subheading}</p>}
          <Buttons t={t} s="deep" buttons={buttons} center class="mt-10" />
        </div>
      </div>
      {image?.url && (
        <figure class:list={['reveal relative z-10 mx-auto max-w-[1100px] px-4', home ? '-mt-36 md:-mt-48' : '-mt-28 md:-mt-36']}>
          <Img image={image} width={1600} fit="max" sizes="(min-width: 1100px) 1100px, 100vw" eager class="h-auto w-full rounded-[2rem] shadow-[0_50px_120px_-40px_rgb(0,28,61,0.55)] ring-8 ring-white" />
        </figure>
      )}
    </section>
  )
}

{
  t === 'c' && (
    <section class="term-grid relative pt-28 pb-16 md:pt-36 md:pb-24">
      <div class:list={['mx-auto grid max-w-[1320px] gap-8 px-5 md:px-8', image?.url ? 'lg:grid-cols-[1.15fr_1fr]' : '']}>
        <div class="reveal overflow-hidden rounded-lg bg-[#0b1324]/95 ring-1 ring-dex/30 shadow-[0_0_80px_-20px_rgb(0,162,219,0.35)]">
          <div class="flex items-center gap-2 border-b border-dex/20 bg-[#0e1830] px-4 py-3 font-mono text-xs text-white/50">
            <span class="h-3 w-3 rounded-full bg-lab" /><span class="h-3 w-3 rounded-full bg-peach" /><span class="h-3 w-3 rounded-full bg-dex" />
            <span class="ml-3">dexlab@maastricht: ~/{slug === 'home' ? '' : slug}</span>
          </div>
          <div class="p-6 md:p-10">
            <p class="font-mono text-sm text-dex"><span class="text-lab">$</span> {home ? 'whoami' : `cat ${slug}.md`}</p>
            {eyebrow && <p class="mt-6 font-mono text-xs uppercase tracking-[0.2em] text-white/50">{eyebrow}</p>}
            <H class:list={['caret mt-5 font-mono font-bold tracking-[-0.04em] leading-[1.02]', home ? 'text-[clamp(2.4rem,6vw,5rem)]' : 'text-[clamp(2.1rem,5vw,4.2rem)]']}>
              <span set:html={brandify(heading)} />
            </H>
            {subheading && (
              <>
                <p class="mt-10 font-mono text-sm text-dex"><span class="text-lab">$</span> cat README.md</p>
                <p class="mt-3 max-w-3xl font-mono text-[0.95rem] leading-7 whitespace-pre-line text-white/75">{subheading}</p>
              </>
            )}
            {buttons?.length ? <Buttons t={t} buttons={buttons} class="mt-10" /> : null}
          </div>
        </div>
        {image?.url && (
          <figure class="reveal relative self-center overflow-hidden rounded-lg ring-1 ring-dex/30">
            <Img image={image} width={1100} fit="max" sizes="(min-width: 1024px) 560px, 100vw" eager class="duotone h-auto w-full" />
            <div class="pointer-events-none absolute inset-0 bg-dex/25 mix-blend-color" />
            <figcaption class="absolute inset-x-0 bottom-0 flex justify-between bg-[#070b14]/85 px-4 py-2 font-mono text-[0.7rem] text-white/60">
              <span>{file}.jpg</span>
              <span>{image.dims ? `${image.dims.width}×${image.dims.height}` : ''}</span>
            </figcaption>
          </figure>
        )}
      </div>
    </section>
  )
}

{
  t === 'd' && (
    <>
      {/* On the home page the hero stays pinned while the visitor scrolls, so the two forms meet on screen. */}
      <section class:list={['relative', home ? 'h-[190svh]' : '']} data-pin={home ? '' : undefined}>
      <div class:list={['isolate flex flex-col overflow-hidden', home ? 'sticky top-0 h-[100svh] pt-28' : 'relative pt-36 md:pt-44']}>
        {home ? (
          <Synapse />
        ) : (
          <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true"><div class="halo-wrap halo-small"><div class="halo"></div></div></div>
        )}
        <div class="reveal mx-auto flex w-full max-w-5xl flex-1 flex-col items-center justify-center px-5 text-center">
          {eyebrow && <p class="mb-6 text-xs font-medium tracking-[0.02em] text-d-fg/50">{eyebrow}</p>}
          <H class:list={['display-d', home ? 'fade-on-scroll' : '', home ? 'text-[clamp(3rem,8.4vw,7.6rem)]' : 'text-[clamp(2.6rem,6.6vw,5.8rem)]']}>
            {brandLine && (
              <>
                <span set:html={brandify(first1)} />
                <br />
              </>
            )}
            {grey && <span class="text-d-fg/30" set:html={brandify(grey) + ' '} />}
            <span set:html={brandify(dark)} />
          </H>
        </div>
        <div class:list={['relative mx-auto w-full max-w-[1320px] items-end gap-6 px-5 pt-10 pb-8 md:grid-cols-[1fr_auto_auto] md:gap-10 md:px-8 md:pb-10', home ? 'hidden md:grid' : 'grid']}>
          {subheading ? (
            <div class="reveal max-w-xl">
              <p class="text-[0.95rem] leading-[1.6] whitespace-pre-line text-d-fg/80">{subheading}</p>
            </div>
          ) : <div />}
          <span class:list={['hidden h-12 w-px self-end bg-d-fg/25', (home || buttons?.length) && 'md:block']} aria-hidden="true" />
          <div class="reveal flex flex-wrap items-center gap-3">
            <Buttons t={t} buttons={buttons} />
            <span class:list={['hidden items-center gap-2 rounded-full px-4 py-3 text-xs text-d-fg/55 ring-1 ring-d-fg/20', home && 'md:inline-flex']} aria-hidden="true">Scroll <span class="animate-bounce">↓</span></span>
          </div>
        </div>
      </div>
      </section>
      {home && (subheading || buttons?.length) ? (
        <div class="px-5 pb-10 md:hidden">
          {subheading && <p class="text-[0.95rem] leading-[1.6] whitespace-pre-line text-d-fg/80">{subheading}</p>}
          <Buttons t={t} buttons={buttons} class="mt-6" />
        </div>
      ) : null}
      {image?.url && (
        <figure class="mx-auto max-w-[1320px] px-3 pb-8 md:px-8">
          <Img image={image} width={1800} fit="max" sizes="(min-width: 1320px) 1260px, 100vw" eager={!home} class="grow-in h-auto w-full rounded-[1.75rem]" />
        </figure>
      )}
    </>
  )
}

{
  t === 'e' && (
    <section class:list={['e-grid relative overflow-hidden border-b-2 border-navy bg-e-paper', home ? 'pt-24' : 'pt-24']} data-calib={home ? '' : undefined}>
      {home && (
        <div class="pointer-events-none fixed inset-0 z-50" aria-hidden="true" data-calib-layer>
          {[[8, 22], [92, 22], [50, 52], [8, 88], [92, 88]].map(([x, y]) => <span class="calib" style={`left:${x}%;top:${y}%`} />)}
          <p data-calib-label class="absolute top-[56%] left-1/2 hidden -translate-x-1/2 bg-navy px-3 py-1.5 font-mono text-[0.7rem] tracking-[0.14em] text-white uppercase">Calibrating</p>
        </div>
      )}
      <div class="relative mx-auto max-w-[1400px] px-4 pt-6 md:px-6">
        {eyebrow && <p class="mb-4 inline-block bg-navy px-2 py-1 font-mono text-[0.7rem] tracking-[0.12em] text-white uppercase">{eyebrow}</p>}
        <H class="e-hero-type display-e">
          {brandLine ? (
            <>
              <span class="block text-[clamp(5rem,23.5vw,22rem)] leading-[0.8]" set:html={brandify(first1)} />
              <span class="block text-[clamp(2.4rem,8.3vw,8rem)]">{restText}</span>
            </>
          ) : (
            <span class="block text-[clamp(3.2rem,10vw,9.5rem)]" set:html={brandify(heading)} />
          )}
        </H>
      </div>
      <div class:list={['relative mx-auto grid max-w-[1400px] gap-8 px-4 pt-10 pb-14 md:px-6', image?.url ? 'lg:grid-cols-[0.9fr_1.1fr] lg:items-start' : '']}>
        {(subheading || buttons?.length) && (
          <div class="reveal max-w-2xl border-2 border-navy bg-white shadow-[6px_6px_0_#001c3d]">
            <p class="border-b-2 border-navy bg-peach px-4 py-2 font-mono text-[0.7rem] font-semibold tracking-[0.14em] uppercase">Abstract</p>
            <div class="p-5 md:p-7">
              {subheading && <p class="text-[1.05rem] leading-[1.65] whitespace-pre-line">{subheading}</p>}
              <Buttons t={t} buttons={buttons} class="mt-6" />
            </div>
          </div>
        )}
        {image?.url && (
          <figure class="reveal relative border-2 border-navy bg-white shadow-[8px_8px_0_#e84e10]">
            <Img image={image} width={1600} fit="max" sizes="(min-width: 1024px) 720px, 100vw" eager class="h-auto w-full" />
            {home && (
              <div class="pointer-events-none absolute inset-0" aria-hidden="true">
                <svg class="absolute inset-0 h-full w-full" viewBox="0 0 100 100" preserveAspectRatio="none">
                  {[[19, 34, 33, 31], [33, 31, 47, 35], [47, 35, 60, 32], [60, 32, 73, 35], [73, 35, 55, 62]].map(([x1, y1, x2, y2], i) => (
                    <line x1={x1} y1={y1} x2={x2} y2={y2} stroke="#001c3d" stroke-width="1.5" vector-effect="non-scaling-stroke" class="gaze-replay" style={`animation-delay:${(i + 1) * 0.7}s`} />
                  ))}
                </svg>
                {[[19, 34, 30], [33, 31, 44], [47, 35, 26], [60, 32, 52], [73, 35, 34], [55, 62, 22]].map(([x, y, r], i) => (
                  <span class="gaze-replay absolute grid -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full border-2 border-lab bg-lab/25 font-mono text-[0.7rem] font-bold text-navy" style={`left:${x}%;top:${y}%;width:${r}px;height:${r}px;animation-delay:${i * 0.7}s`}>{i + 1}</span>
                ))}
              </div>
            )}
          </figure>
        )}
      </div>
    </section>
  )
}

<script>
  // Version E home: a short eye-tracker style calibration before the headline appears.
  const calib = document.querySelector<HTMLElement>('[data-calib]')
  if (calib) {
    const skip = matchMedia('(prefers-reduced-motion: reduce)').matches || sessionStorage.getItem('dex-calib')
    if (!skip) {
      const dots = [...calib.querySelectorAll<HTMLElement>('.calib')]
      const label = calib.querySelector<HTMLElement>('[data-calib-label]')!
      calib.classList.add('calibrating')
      label.classList.remove('hidden')
      const timers: number[] = []
      const finish = () => {
        timers.forEach(clearTimeout)
        dots.forEach((d) => d.classList.add('done'))
        label.classList.add('hidden')
        calib.classList.remove('calibrating')
        try { sessionStorage.setItem('dex-calib', '1') } catch {}
      }
      dots.forEach((d, i) => timers.push(window.setTimeout(() => {
        dots.forEach((x) => x.classList.remove('on'))
        d.classList.add('on')
      }, 200 + i * 430)))
      timers.push(window.setTimeout(finish, 200 + dots.length * 430 + 150))
      window.addEventListener('pointerdown', finish, {once: true})
      window.addEventListener('keydown', finish, {once: true})
    }
  }
</script>
