---
// Hand-drawn accents in the spirit of the reference: an underline, a loop and a spark.
interface Props {
  kind: 'underline' | 'loop' | 'spark' | 'arrow'
  class?: string
  color?: string
}
const {kind, class: className = '', color = '#e84e10'} = Astro.props
---

{kind === 'underline' && (
  <svg class={className} viewBox="0 0 300 24" fill="none" aria-hidden="true"><path d="M4 16c40-9 90-12 140-10 50 2 98 6 152-4" stroke={color} stroke-width="6" stroke-linecap="round" /></svg>
)}
{kind === 'loop' && (
  <svg class={className} viewBox="0 0 220 220" fill="none" aria-hidden="true"><path d="M110 14c52 0 96 38 96 92s-44 98-98 98S14 160 14 108C14 60 52 26 98 22c34-3 70 10 88 34" stroke={color} stroke-width="5" stroke-linecap="round" /></svg>
)}
{kind === 'spark' && (
  <svg class={className} viewBox="0 0 60 60" fill="none" aria-hidden="true"><path d="M30 4v14M30 42v14M4 30h14M42 30h14M12 12l9 9M39 39l9 9M48 12l-9 9M21 39l-9 9" stroke={color} stroke-width="4" stroke-linecap="round" /></svg>
)}
{kind === 'arrow' && (
  <svg class={className} viewBox="0 0 120 60" fill="none" aria-hidden="true"><path d="M6 44C34 10 70 4 104 22M104 22l-16-12M104 22l-18 6" stroke={color} stroke-width="4" stroke-linecap="round" stroke-linejoin="round" /></svg>
)}
