---
// Version E footer: a service-robot face whose eyes follow the visitor and blink now and then.
---

<div class="robot relative mx-auto h-40 w-56 shrink-0 select-none" aria-hidden="true" data-robot>
  <span class="absolute top-0 left-1/2 h-6 w-1 -translate-x-1/2 bg-white"></span>
  <span class="absolute -top-2 left-1/2 h-4 w-4 -translate-x-1/2 rounded-full bg-lab"></span>
  <div class="absolute inset-x-0 top-5 bottom-0 rounded-[2.2rem] border-[3px] border-white bg-[#0b2447] shadow-[6px_6px_0_#e84e10]">
    <div class="absolute inset-x-5 top-5 bottom-8 flex items-center justify-around rounded-[1.4rem] bg-black/60">
      <span class="eye relative h-14 w-14 overflow-hidden rounded-full bg-white"><span data-pupil class="absolute top-1/2 left-1/2 h-6 w-6 -translate-x-1/2 -translate-y-1/2 rounded-full bg-dex shadow-[0_0_14px_#00a2db]"></span><span data-lid class="absolute inset-x-0 top-0 h-0 bg-[#0b2447] transition-[height] duration-100"></span></span>
      <span class="eye relative h-14 w-14 overflow-hidden rounded-full bg-white"><span data-pupil class="absolute top-1/2 left-1/2 h-6 w-6 -translate-x-1/2 -translate-y-1/2 rounded-full bg-dex shadow-[0_0_14px_#00a2db]"></span><span data-lid class="absolute inset-x-0 top-0 h-0 bg-[#0b2447] transition-[height] duration-100"></span></span>
    </div>
    <span class="absolute bottom-3 left-1/2 h-1.5 w-12 -translate-x-1/2 rounded-full bg-lab"></span>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-robot]').forEach((robot) => {
    const pupils = [...robot.querySelectorAll<HTMLElement>('[data-pupil]')]
    const lids = [...robot.querySelectorAll<HTMLElement>('[data-lid]')]
    window.addEventListener('pointermove', (e) => {
      pupils.forEach((p) => {
        const r = p.parentElement!.getBoundingClientRect()
        const a = Math.atan2(e.clientY - (r.top + r.height / 2), e.clientX - (r.left + r.width / 2))
        const d = Math.min(14, Math.hypot(e.clientX - r.left, e.clientY - r.top) / 30)
        p.style.transform = `translate(calc(-50% + ${Math.cos(a) * d}px), calc(-50% + ${Math.sin(a) * d}px))`
      })
    }, {passive: true})
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return
    const blink = () => {
      lids.forEach((l) => (l.style.height = '100%'))
      setTimeout(() => lids.forEach((l) => (l.style.height = '0')), 130)
      setTimeout(blink, 2500 + Math.random() * 3500)
    }
    setTimeout(blink, 2000)
  })
</script>
