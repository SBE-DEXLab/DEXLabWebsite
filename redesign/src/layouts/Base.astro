---
import '../styles/global.css'
import {NAV} from '../lib/content'

interface Props {
  title: string
  theme: 'night' | 'light'
}
const {title, theme} = Astro.props
const night = theme === 'night'
const socials = [
  {label: 'LinkedIn', href: 'https://www.linkedin.com/company/sbedexlab', path: 'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05C20.6 8.65 21 11.3 21 14.7V21h-4v-5.6c0-1.34-.03-3.06-1.86-3.06-1.87 0-2.15 1.46-2.15 2.96V21H9z'},
  {label: 'Instagram', href: 'https://www.instagram.com/sbe.dexlab/', path: 'M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0 8.2a3.2 3.2 0 1 1 0-6.4 3.2 3.2 0 0 1 0 6.4zM17.3 5.5a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4zM12 2c-2.7 0-3 0-4.1.06C4.2 2.23 2.23 4.2 2.06 7.9 2 9 2 9.3 2 12s0 3 .06 4.1c.17 3.7 2.14 5.67 5.84 5.84C9 22 9.3 22 12 22s3 0 4.1-.06c3.7-.17 5.67-2.14 5.84-5.84C22 15 22 14.7 22 12s0-3-.06-4.1C21.77 4.2 19.8 2.23 16.1 2.06 15 2 14.7 2 12 2z'},
  {label: 'YouTube', href: 'https://www.youtube.com/watch?v=ObP_syT_xpY', path: 'M21.6 7.2a2.5 2.5 0 0 0-1.76-1.77C18.3 5 12 5 12 5s-6.3 0-7.84.43A2.5 2.5 0 0 0 2.4 7.2 26 26 0 0 0 2 12a26 26 0 0 0 .4 4.8 2.5 2.5 0 0 0 1.76 1.77C5.7 19 12 19 12 19s6.3 0 7.84-.43a2.5 2.5 0 0 0 1.76-1.77A26 26 0 0 0 22 12a26 26 0 0 0-.4-4.8zM10 15V9l5.2 3z'},
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <link rel="icon" href="/brand/icon-32.png" />
  </head>
  <body class:list={[night ? 'bg-night text-white' : 'bg-white text-navy']}>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-white focus:px-4 focus:py-2 focus:text-navy">Skip to content</a>
    <header class:list={['fixed inset-x-0 top-0 z-40 transition-colors duration-300', night ? 'header-night' : 'header-light']} data-header>
      <div class="mx-auto flex max-w-[1320px] items-center justify-between gap-6 px-5 py-4 md:px-8">
        <a href="#" class="shrink-0" aria-label="DEXLab home">
          {night ? (
            <img src="/brand/dexlab-logo-header-light.png" alt="DEXLab" width="96" height="56" class="h-12 w-auto" />
          ) : (
            <>
              <img src="/brand/dexlab-logo-header-light.png" alt="DEXLab" width="96" height="56" class="logo-top h-12 w-auto" />
              <img src="/brand/dexlab-logo-header.png" alt="" width="96" height="56" class="logo-scrolled hidden h-12 w-auto" />
            </>
          )}
        </a>
        <nav aria-label="Main" class="hidden lg:block">
          <ul class:list={['flex items-center gap-1 rounded-full px-2 py-1.5 text-[0.82rem] font-semibold backdrop-blur', night ? 'bg-white/5 ring-1 ring-white/10' : 'bg-white/70 ring-1 ring-navy/10']}>
            {NAV.map((n) => (
              <li>
                <a href={n.href} class:list={['rounded-full px-3 py-2 transition-colors', night ? 'text-white/80 hover:bg-white/10 hover:text-white' : 'text-navy/80 hover:bg-navy/5 hover:text-navy']}>
                  {n.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <details class="relative lg:hidden">
          <summary class:list={['flex cursor-pointer list-none items-center gap-2 rounded-full px-4 py-2 text-sm font-bold', night ? 'bg-white/10 text-white' : 'bg-navy text-white']}>Menu</summary>
          <ul class:list={['absolute right-0 mt-3 w-60 rounded-2xl p-2 shadow-2xl', night ? 'bg-night-2 ring-1 ring-white/10' : 'bg-white ring-1 ring-navy/10']}>
            {NAV.map((n) => (
              <li><a href={n.href} class="block rounded-xl px-4 py-2.5 text-sm font-semibold hover:bg-dex/10">{n.label}</a></li>
            ))}
          </ul>
        </details>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class:list={['relative overflow-hidden', night ? 'bg-black/30 text-white' : 'bg-navy text-white']}>
      <div class="mx-auto grid max-w-[1320px] gap-12 px-5 py-16 md:grid-cols-[1.2fr_1fr_1fr] md:px-8">
        <div>
          <img src="/brand/dexlab-logo-header-light.png" alt="DEXLab" width="110" height="64" class="h-14 w-auto" />
          <img src="/brand/um-sbe-logo-light.png" alt="Maastricht University School of Business and Economics" width="200" height="50" class="mt-6 h-10 w-auto opacity-90" />
        </div>
        <div class="text-sm leading-7 text-white/80">
          <p class="mb-2 font-display text-base font-bold text-white"><span class="brand-dex">DEX</span><span class="brand-lab">Lab</span></p>
          <p>Tapijnkazerne 11 (I1.017)<br />6211 ME Maastricht<br />The Netherlands</p>
          <a class="mt-2 inline-block text-white underline decoration-dex decoration-2 underline-offset-4" href="mailto:sbe-dexlab@maastrichtuniversity.nl">sbe-dexlab@maastrichtuniversity.nl</a>
        </div>
        <div>
          <p class="mb-4 font-display text-base font-bold">Follow us:</p>
          <ul class="flex gap-3">
            {socials.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener" aria-label={s.label} class="grid h-11 w-11 place-items-center rounded-full bg-white/10 transition hover:bg-dex">
                  <svg viewBox="0 0 24 24" class="h-5 w-5 fill-white" aria-hidden="true"><path d={s.path} /></svg>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <p class="border-t border-white/10 px-5 py-6 text-center text-xs text-white/60">© 2026 DEXLab | Photos by Nils Backes | <a class="underline" href="https://www.sbe-dexlab.com/privacy">Privacy</a></p>
    </footer>

    <script>
      const header = document.querySelector<HTMLElement>('[data-header]')!
      const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 24)
      onScroll()
      window.addEventListener('scroll', onScroll, {passive: true})
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => e.isIntersecting && (e.target.classList.add('in'), io.unobserve(e.target))),
        {rootMargin: '0px 0px -8% 0px'},
      )
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el))
    </script>
    <style is:global>
      .header-night.scrolled { background: rgb(10 20 38 / 0.82); backdrop-filter: blur(14px); box-shadow: 0 1px 0 rgb(255 255 255 / 0.06); }
      .header-light.scrolled .logo-top { display: none; }
      .header-light.scrolled .logo-scrolled { display: block; }
      .header-light.scrolled { background: rgb(255 255 255 / 0.85); backdrop-filter: blur(14px); box-shadow: 0 1px 0 rgb(0 28 61 / 0.08); }
    </style>
  </body>
</html>
