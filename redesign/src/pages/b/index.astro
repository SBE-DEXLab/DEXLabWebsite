---
import Base from '../../layouts/Base.astro'
import Shader from '../../components/Shader.astro'
import {getHome, getPosts, getProjects, img, live} from '../../lib/content'
import {brandify} from '../../lib/brand'

const [home, posts, projects] = await Promise.all([getHome(), getPosts(3), getProjects()])
const hero = home.hero
const cats: Record<string, string> = {research: 'Research', phd: 'PhD project', education: 'Education', network: 'Network'}
const words = ['Mixed reality', 'Service robots', 'GenAI', 'Biometric tools', 'Immersive experiences', 'Artificial intelligence']
const icons = [
  'M4 19.5V5a2 2 0 0 1 2-2h12v16H6a2 2 0 0 0-2 2zm0 0A2 2 0 0 0 6 22h12',
  'M9 3h6M10 3v6L4.5 19A2 2 0 0 0 6.3 22h11.4a2 2 0 0 0 1.8-3L14 9V3',
  'M3 7h18v13H3zM8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 13h18',
]
const lightPalettes = [
  ['#fce8e0', '#00a2db', '#ffffff', '#2d85c6'],
  ['#e8f5fb', '#e84e10', '#fce8e0', '#ffffff'],
  ['#ffffff', '#2d85c6', '#fce8e0', '#00a2db'],
  ['#fce8e0', '#001c3d', '#00a2db', '#ffffff'],
]
const date = (d: string) => new Date(d).toLocaleDateString('en-GB', {day: 'numeric', month: 'short', year: 'numeric'})
---

<Base title="DEXLab | Direction B: Light Shader" theme="light">
  <!-- Hero: full-bleed shader -->
  <section class="relative px-3 pt-3">
    <div class="grain relative isolate overflow-hidden rounded-[2.5rem] pt-36 pb-48 text-white md:pt-44 md:pb-64">
      <div class="absolute inset-0 -z-10"><Shader colors={['#001c3d', '#00a2db', '#e84e10', '#0a1426']} seed={3} speed={0.8} /></div>
      <div class="absolute inset-0 -z-10 bg-navy/25"></div>
      <div class="reveal mx-auto max-w-5xl px-5 text-center">
        <h1 class="display text-[clamp(3rem,8.5vw,7.5rem)]">
          <span class="brand-dex !text-white">DEX</span><span class="text-lab">Lab</span> the Digital Experience Lab
        </h1>
        <p class="mx-auto mt-8 max-w-3xl text-lg leading-8 text-white/85">{hero.subheading}</p>
        <div class="mt-10 flex justify-center">
          {hero.buttons?.map((b: {label: string; href: string}) => (
            <a href={live(b.href)} class="group inline-flex items-center gap-3 rounded-full bg-white px-8 py-4 font-display text-sm font-bold text-navy shadow-xl transition hover:-translate-y-0.5">
              {b.label}<span class="transition group-hover:translate-x-1" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </div>
    </div>
    <figure class="reveal relative z-10 mx-auto -mt-36 max-w-[1100px] px-4 md:-mt-48">
      <img src={img(hero.image, 1600, 900)} alt={hero.image?.alt || 'The DEXLab team'} width="1600" height="900" class="aspect-[16/9] w-full rounded-[2rem] object-cover shadow-[0_50px_120px_-40px_rgb(0,28,61,0.55)] ring-8 ring-white" style="object-position:50% 62%" />
    </figure>
  </section>

  <!-- Marquee -->
  <div class="relative mt-16 overflow-hidden border-y border-line py-5" aria-hidden="true">
    <div class="marquee flex w-max gap-12 whitespace-nowrap font-display text-2xl font-extrabold tracking-tight text-navy/80">
      {[...words, ...words, ...words, ...words].map((w, i) => (
        <span class="flex items-center gap-12">{w}<span class:list={['h-3 w-3 rounded-full', i % 2 ? 'bg-lab' : 'bg-dex']}></span></span>
      ))}
    </div>
  </div>

  <!-- What we do: bento -->
  <section class="py-24 md:py-32">
    <div class="mx-auto grid max-w-[1240px] gap-5 px-5 md:grid-cols-3 md:px-8">
      <div class="reveal flex flex-col justify-between rounded-[2rem] bg-peach p-10 md:col-span-2 md:row-span-1">
        <h2 class="display text-[clamp(2.4rem,5vw,4.2rem)]" set:html={brandify(home.cards.heading)} />
        <p class="mt-8 max-w-2xl text-lg leading-8 text-navy/80">{home.cards.intro}</p>
      </div>
      {home.cards.items.map((c: {title: string; text: string; href: string}, i: number) => (
        <a href={live(c.href)} class:list={['reveal group flex flex-col rounded-[2rem] p-9 ring-1 transition hover:-translate-y-1 hover:shadow-[0_30px_60px_-30px_rgb(0,28,61,0.35)]', i === 0 ? 'bg-navy text-white ring-navy' : 'bg-white ring-line']}>
          <span class:list={['mb-10 grid h-14 w-14 place-items-center rounded-2xl', i === 0 ? 'bg-white/10' : i === 1 ? 'bg-dex/10' : 'bg-lab/10']}>
            <svg viewBox="0 0 24 24" fill="none" class:list={['h-7 w-7', i === 0 ? 'stroke-white' : i === 1 ? 'stroke-dex-dark' : 'stroke-lab']} stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[i]} /></svg>
          </span>
          <h3 class="display mb-4 text-3xl">{c.title}</h3>
          <p class:list={['leading-7', i === 0 ? 'text-white/75' : 'text-navy/75']}>{c.text}</p>
          <span class:list={['mt-auto pt-8 font-display text-sm font-bold', i === 0 ? 'text-dex' : 'text-dex-dark']}>View More <span class="inline-block transition group-hover:translate-x-1" aria-hidden="true">→</span></span>
        </a>
      ))}
    </div>
  </section>

  <!-- Goal -->
  <section class="relative mx-3 overflow-hidden rounded-[2.5rem] bg-navy py-24 text-white md:py-32">
    <div class="pointer-events-none absolute -right-32 -top-32 h-96 w-96 rounded-full bg-dex/30 blur-3xl"></div>
    <div class="relative mx-auto grid max-w-[1240px] gap-12 px-5 md:px-8 lg:grid-cols-[1.4fr_1fr]">
      <p class="reveal display text-[clamp(1.9rem,3.6vw,3.2rem)] leading-[1.08]">{home.goal.paras[0]}</p>
      <div class="reveal space-y-6 text-lg leading-8 text-white/80">
        {home.goal.paras.slice(1).map((p: string) => <p>{p}</p>)}
        {home.goal.buttons?.map((b: {label: string; href: string}) => (
          <a href={live(b.href)} class="inline-flex items-center gap-3 rounded-full bg-white px-7 py-4 font-display text-sm font-bold text-navy transition hover:bg-dex hover:text-white">{b.label} <span aria-hidden="true">→</span></a>
        ))}
      </div>
    </div>
  </section>

  <!-- Projects: shader cards -->
  <section class="py-24 md:py-32">
    <div class="mx-auto max-w-[1240px] px-5 md:px-8">
      <div class="reveal mb-14 flex flex-wrap items-end justify-between gap-6">
        <h2 class="display text-[clamp(2.4rem,5vw,4.2rem)]">Our Projects</h2>
        <a href="https://sbe-dexlab.pages.dev/projects/" class="inline-flex items-center gap-2 rounded-full bg-navy px-6 py-3 font-display text-sm font-bold text-white transition hover:bg-dex-dark">Our Projects <span aria-hidden="true">→</span></a>
      </div>
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {projects.slice(0, 4).map((p: any, i: number) => (
          <article class="reveal group flex flex-col overflow-hidden rounded-[1.75rem] bg-white ring-1 ring-line transition hover:-translate-y-1 hover:shadow-[0_30px_60px_-30px_rgb(0,28,61,0.35)]">
            <div class="relative h-44 overflow-hidden"><Shader colors={lightPalettes[i % 4]} seed={i + 7} speed={0.7} /></div>
            <div class="flex flex-1 flex-col p-6">
              <p class="mb-3 flex flex-wrap items-center gap-2 text-[0.7rem] font-bold uppercase tracking-wider">
                <span class="rounded-md border-l-[3px] border-dex bg-dex/10 px-2 py-1 text-navy">{cats[p.category]}</span>
                <span class="text-navy/60">{p.status === 'completed' ? 'Completed' : 'Current'}</span>
              </p>
              <h3 class="font-display text-lg font-bold leading-snug">{p.title}</h3>
              {p.team?.length ? <p class="mt-auto pt-5 text-xs leading-5 text-navy/60">{p.team.join(', ')}</p> : null}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- News -->
  <section class="bg-paper py-24 md:py-32">
    <div class="mx-auto max-w-[1240px] px-5 md:px-8">
      <h2 class="reveal display mb-14 text-[clamp(2.4rem,5vw,4.2rem)]">{home.news.heading}</h2>
      <div class="grid gap-6 md:grid-cols-3">
        {posts.map((p: any) => (
          <a href={live(`/post/${p.slug}`)} class="reveal group block overflow-hidden rounded-[1.75rem] bg-white ring-1 ring-line transition hover:-translate-y-1 hover:shadow-[0_30px_60px_-30px_rgb(0,28,61,0.35)]">
            <img src={img(p.coverImage, 800, 560)} alt="" width="800" height="560" loading="lazy" class="aspect-[10/7] w-full object-cover" />
            <div class="p-6">
              <p class="text-xs font-bold uppercase tracking-wider text-navy/50">{date(p.publishedAt)}</p>
              <h3 class="mt-2 font-display text-lg font-bold leading-snug group-hover:text-dex-dark" set:html={brandify(p.title)} />
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
