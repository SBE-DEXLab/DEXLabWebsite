---
import Site from '../../../layouts/Site.astro'
import H from '../../../components/site/H.astro'
import PostCard from '../../../components/col/PostCard.astro'
import {getPosts, getCategories} from '../../../lib/site/queries'
import {look, THEMES, type Theme} from '../../../lib/theme'

export const getStaticPaths = () => THEMES.map((t) => ({params: {t}}))
const t = Astro.params.t as Theme
const k = look(t)
const [posts, cats] = await Promise.all([getPosts(), getCategories()])
---

<Site t={t} title="Blog" path="/blog" solid>
  <section class:list={['pt-36 pb-24', t === 'c' ? 'term-grid' : '']}>
    <div class="mx-auto max-w-[1240px] px-5 md:px-8">
      <H t={t} level={1} size="xl" text="Blog" class="reveal" />
      <div class="reveal mt-10 flex flex-wrap gap-2" role="group" aria-label="Filter by category" data-blog-filters>
        <button type="button" data-cat="" aria-pressed="true" class:list={['blog-filter px-4 py-2 text-sm font-bold', k.font, t === 'c' ? 'rounded ring-1 ring-dex/40' : 'rounded-full ring-1', k.dark ? 'ring-white/20' : 'ring-line']}>All</button>
        {cats.filter((c: any) => c.count).map((c: any) => (
          <button type="button" data-cat={c.slug} aria-pressed="false" class:list={['blog-filter px-4 py-2 text-sm font-bold', k.font, t === 'c' ? 'rounded ring-1 ring-dex/40' : 'rounded-full ring-1', k.dark ? 'ring-white/20' : 'ring-line']}>{c.title} <span class="opacity-60">{c.count}</span></button>
        ))}
      </div>
      <ul class="mt-14 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((p: any) => <li data-cats={(p.categories || []).map((c: any) => c.slug).join(' ')}><PostCard t={t} p={p} /></li>)}
      </ul>
    </div>
  </section>
  <script>
    const btns = [...document.querySelectorAll<HTMLButtonElement>('[data-blog-filters] button')]
    const items = [...document.querySelectorAll<HTMLElement>('li[data-cats]')]
    btns.forEach((b) => b.addEventListener('click', () => {
      btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)))
      items.forEach((it) => (it.hidden = !!b.dataset.cat && !it.dataset.cats!.split(' ').includes(b.dataset.cat!)))
    }))
  </script>
  <style is:global>
    .blog-filter[aria-pressed='true'] { background: var(--color-lab); color: #fff; }
    li[hidden] { display: none; }
  </style>
</Site>
