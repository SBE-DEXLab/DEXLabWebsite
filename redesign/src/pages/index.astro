---
import '../styles/global.css'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>DEXLab redesign preview</title>
  </head>
  <body class="grid min-h-screen place-items-center bg-paper p-6 text-navy">
    <main class="w-full max-w-3xl">
      <img src="/brand/dexlab-logo-header.png" alt="DEXLab" width="110" height="64" class="mb-10 h-14 w-auto" />
      <h1 class="display text-5xl">Website redesign preview</h1>
      <p class="mt-4 text-lg text-navy/75">Two directions for the home page, same copy and content as the current site. Links lead to the current pages.</p>
      <div class="mt-10 grid gap-5 md:grid-cols-2">
        <a href="/a/" class="group rounded-3xl bg-night p-8 text-white transition hover:-translate-y-1">
          <p class="text-sm font-bold text-dex">Direction A</p>
          <p class="display mt-2 text-3xl">Night Lab</p>
          <p class="mt-3 text-white/70">Dark, big type, hand-drawn accents and shader cards.</p>
        </a>
        <a href="/b/" class="group rounded-3xl bg-white p-8 ring-1 ring-line transition hover:-translate-y-1">
          <p class="text-sm font-bold text-lab">Direction B</p>
          <p class="display mt-2 text-3xl">Light Shader</p>
          <p class="mt-3 text-navy/70">Light, animated gradient hero, bento grid and soft cards.</p>
        </a>
      </div>
    </main>
  </body>
</html>
