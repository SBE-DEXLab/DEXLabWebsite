---
import '@fontsource-variable/nunito-sans'
import '@fontsource-variable/open-sans'
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import {getSettings} from '../lib/queries'
import {imageUrl} from '../lib/image'
import type {Img} from '../lib/types'

interface Props {
  title?: string
  description?: string
  image?: Img
  type?: 'website' | 'article'
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]
  noindex?: boolean
}

const settings = await getSettings()
const {title, description, image, type = 'website', jsonLd, noindex} = Astro.props
const siteTitle = settings?.title || 'DEXLab'
const fullTitle = title ? `${title} | ${siteTitle}` : `${siteTitle} | Digital Experience Lab, Maastricht University`
const desc = description || settings?.description || ''
const canonical = new URL(Astro.url.pathname, Astro.site)
const ogImage = imageUrl(image || settings?.ogImage, {width: 1200, height: 630}) || new URL('/brand/og-default.png', Astro.site).href
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'ResearchOrganization',
  name: 'DEXLab, Digital Experience Lab',
  url: Astro.site?.href,
  logo: new URL('/brand/icon-512.png', Astro.site).href,
  email: settings?.email,
  parentOrganization: {'@type': 'CollegeOrUniversity', name: 'Maastricht University School of Business and Economics'},
  address: {'@type': 'PostalAddress', streetAddress: 'Tapijnkazerne 11', postalCode: '6211 ME', addressLocality: 'Maastricht', addressCountry: 'NL'},
  sameAs: settings?.socials?.map((s) => s.url),
}
const ld = [orgLd, ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [])]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/brand/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="DEXLab blog" href="/rss.xml" />
    <meta name="theme-color" content="#071c3d" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title || siteTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={siteTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header settings={settings} />
    <main id="main">
      <slot />
    </main>
    <Footer settings={settings} />
  </body>
</html>
