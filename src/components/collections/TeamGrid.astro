---
import Img from '../Img.astro'
import SocialIcon from '../SocialIcon.astro'
import {getPeople} from '../../lib/queries'

interface Props {
  groups: string[]
}
const {groups} = Astro.props
const people = await getPeople(groups)
const titles: Record<string, string> = {core: 'Our core team', intern: 'The interns', associate: 'The associates', alumni: 'Alumni'}
---

{
  groups.map((g) => {
    const members = people.filter((p) => p.group === g)
    if (!members.length) return null
    return (
      <div class:list={['group', `group-${g}`]}>
        <h2 class="group-title">{titles[g]}</h2>
        <ul class="team">
          {members.map((p) => (
            <li class="person">
              <div class="photo">
                {p.photo?.url ? (
                  <Img image={p.photo} width={360} height={480} sizes="(min-width: 1000px) 270px, 45vw" alt={`Portrait of ${p.name}`} />
                ) : (
                  <span class="initials" aria-hidden="true">{p.name.split(' ').map((n) => n[0]).slice(0, 2).join('')}</span>
                )}
                {(p.linkedin || p.website) && (
                  <div class="links">
                    {p.linkedin && (
                      <a href={p.linkedin} target="_blank" rel="noopener" aria-label={`${p.name} on LinkedIn`}>
                        <SocialIcon platform="linkedin" size={16} />
                      </a>
                    )}
                    {p.website && (
                      <a href={p.website} target="_blank" rel="noopener" aria-label={`${p.name}, profile page`}>
                        <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm6.9 6h-3a15.6 15.6 0 0 0-1.4-4A8 8 0 0 1 18.9 8zM12 4c.8 1.2 1.5 2.5 1.9 4h-3.8c.4-1.5 1.1-2.8 1.9-4zM4.3 14a8.2 8.2 0 0 1 0-4h3.4a16.5 16.5 0 0 0 0 4H4.3zm.8 2h3a15.6 15.6 0 0 0 1.4 4A8 8 0 0 1 5.1 16zm3-8h-3a8 8 0 0 1 4.3-4A15.6 15.6 0 0 0 8.1 8zM12 20c-.8-1.2-1.5-2.5-1.9-4h3.8c-.4 1.5-1.1 2.8-1.9 4zm2.3-6H9.7a14.7 14.7 0 0 1 0-4h4.6a14.7 14.7 0 0 1 0 4zm.3 6a15.6 15.6 0 0 0 1.4-4h3a8 8 0 0 1-4.4 4zm1.7-6a16.5 16.5 0 0 0 0-4h3.4a8.2 8.2 0 0 1 0 4h-3.4z"/></svg>
                      </a>
                    )}
                  </div>
                )}
              </div>
              <div class="info">
                <h3>{p.name}</h3>
                {p.role && <p class="role">{p.role}</p>}
                {p.bio && <p class="bio">{p.bio}</p>}
              </div>
            </li>
          ))}
        </ul>
      </div>
    )
  })
}

<style>
  .group + .group {
    margin-top: clamp(56px, 8vw, 96px);
  }
  .group-title {
    text-align: center;
    margin-bottom: 36px;
  }
  .group-title::after {
    content: '';
    display: block;
    width: 56px;
    height: 4px;
    border-radius: 4px;
    margin: 16px auto 0;
    background: linear-gradient(90deg, var(--blue) 0 50%, var(--orange) 50% 100%);
  }
  .team {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 28px;
  }
  .team > li {
    flex: 0 1 250px;
  }
  .person {
    text-align: center;
  }
  .photo {
    position: relative;
    aspect-ratio: 3 / 4;
    border-radius: var(--radius);
    overflow: hidden;
    background: linear-gradient(135deg, var(--peach), #dbeef7);
    box-shadow: var(--shadow);
  }
  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s;
  }
  .person:hover .photo :global(img) {
    transform: scale(1.04);
  }
  .initials {
    display: grid;
    place-items: center;
    height: 100%;
    font: 800 3rem var(--font-head);
    color: var(--navy);
  }
  .links {
    position: absolute;
    right: 12px;
    bottom: 12px;
    display: flex;
    gap: 8px;
  }
  .links a {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #fff;
    color: var(--navy);
    box-shadow: var(--shadow);
    transition: background 0.2s, color 0.2s;
  }
  .links a:hover {
    background: var(--blue);
    color: #fff;
  }
  .info {
    padding: 16px 8px 0;
  }
  .info h3 {
    margin: 0 0 4px;
    font-size: 1.2rem;
  }
  .role {
    margin: 0;
    color: var(--orange);
    font-weight: 600;
    font-size: 0.95rem;
  }
  .bio {
    margin: 8px 0 0;
    font-size: 0.92rem;
    color: var(--muted);
  }
  .group-associate .team > li {
    flex-basis: 200px;
  }
  @media (max-width: 560px) {
    .team > li,
    .group-associate .team > li {
      flex-basis: calc(50% - 14px);
    }
  }
</style>
