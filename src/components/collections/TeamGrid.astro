---
import Img from '../Img.astro'
import {getPeople} from '../../lib/queries'
import {brandify} from '../../lib/utils'

interface Props {
  groups: string[]
}
const {groups} = Astro.props
const people = await getPeople(groups)
const titles: Record<string, string> = {core: 'Our Core Team', intern: 'The Interns', associate: 'Affiliated Researchers', alumni: 'Alumni'}
// Every card shows the same three things: portrait, name and role. Hovering over (or tapping) a
// portrait shows the bio on top of it; without a bio the portrait links to LinkedIn.
// Up to five cards per row; bigger groups are split into balanced rows (7 becomes 4 + 3).
const perRow = (n: number) => (n <= 5 ? n : Math.ceil(n / Math.ceil(n / 5)))
---

{
  groups.map((g) => {
    const members = people.filter((p) => p.group === g)
    if (!members.length) return null
    // Alumni: smaller photo cards grouped by the academic year they started, newest first.
    if (g === 'alumni') {
      const years = [...new Set(members.map((p) => p.period || 'Earlier'))].sort().reverse()
      return (
        <div class="group group-alumni">
          <h2 class="rule">{titles[g]}</h2>
          {years.map((y) => (
            <div class="alumni-year">
              <h3>{y}</h3>
              <ul class="alumni">
                {members
                  .filter((p) => (p.period || 'Earlier') === y)
                  .map((p) => {
                    const inner = (
                      <>
                        <span class="alum-photo">
                          {p.photo?.url ? (
                            <Img image={p.photo} width={240} height={240} sizes="120px" alt={`Portrait of ${p.name}`} />
                          ) : (
                            <span class="initials small" aria-hidden="true">{p.name.split(' ').map((n) => n[0]).slice(0, 2).join('')}</span>
                          )}
                        </span>
                        <span class="alum-name">{p.name}</span>
                        {p.role && <span class="alum-role">{p.role}</span>}
                      </>
                    )
                    return <li>{p.introPost ? <a href={`/post/${p.introPost}`}>{inner}</a> : <div>{inner}</div>}</li>
                  })}
              </ul>
            </div>
          ))}
        </div>
      )
    }
    return (
      <div class:list={['group', `group-${g}`]}>
        <h2 class="rule">{titles[g]}</h2>
        <ul class="team" style={`--cols: ${perRow(members.length)}`}>
          {members.map((p) => {
            const photo = p.photo?.url ? (
              <Img image={p.photo} width={400} height={540} sizes="(min-width: 1100px) 230px, 45vw" alt={`Portrait of ${p.name}`} />
            ) : (
              <span class="initials" aria-hidden="true">{p.name.split(' ').map((n) => n[0]).slice(0, 2).join('')}</span>
            )
            return (
              <li class="person">
                {p.bio ? (
                  <>
                    <button type="button" class="photo has-bio" aria-label={`About ${p.name}`} aria-expanded="false" data-bio-toggle>
                      {photo}
                      <span class="bio-hint" aria-hidden="true">Bio</span>
                    </button>
                    <div class="bio" role="dialog" aria-label={`About ${p.name}`}>
                      <button type="button" class="bio-close" aria-label="Close" data-bio-close>
                        ×
                      </button>
                      <p class="bio-name">{p.name}</p>
                      <p>{p.bio}</p>
                      {p.linkedin && (
                        <a href={p.linkedin} target="_blank" rel="noopener">
                          LinkedIn ↗
                        </a>
                      )}
                    </div>
                  </>
                ) : p.linkedin ? (
                  <a class="photo" href={p.linkedin} target="_blank" rel="noopener" title={`${p.name} on LinkedIn`}>
                    {photo}
                  </a>
                ) : (
                  <div class="photo">{photo}</div>
                )}
                <h3 class="name">
                  {p.linkedin ? (
                    <a href={p.linkedin} target="_blank" rel="noopener">
                      {p.name}
                    </a>
                  ) : (
                    p.name
                  )}
                </h3>
                {p.role && <p class="role" set:html={brandify(p.role)} />}
              </li>
            )
          })}
        </ul>
      </div>
    )
  })
}

<script>
  // Tap (touch) or Enter/Space opens a bio; tapping elsewhere, the close button or Escape closes it.
  const people = document.querySelectorAll<HTMLElement>('.person')
  const closeAll = () =>
    people.forEach((p) => {
      p.classList.remove('open')
      p.querySelector('[data-bio-toggle]')?.setAttribute('aria-expanded', 'false')
    })
  document.querySelectorAll<HTMLButtonElement>('[data-bio-toggle]').forEach((b) =>
    b.addEventListener('click', (e) => {
      e.stopPropagation()
      const person = b.closest('.person')!
      const wasOpen = person.classList.contains('open')
      closeAll()
      if (!wasOpen) {
        person.classList.add('open')
        b.setAttribute('aria-expanded', 'true')
      }
    }),
  )
  document.querySelectorAll('[data-bio-close]').forEach((b) => b.addEventListener('click', closeAll))
  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('.bio')) closeAll()
  })
  document.addEventListener('keydown', (e) => e.key === 'Escape' && closeAll())
</script>

<style>
  .group + .group {
    margin-top: clamp(64px, 8vw, 104px);
  }
  .group h2 {
    text-align: center;
    margin-bottom: clamp(32px, 4vw, 48px);
  }
  .team {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 40px 20px;
    max-width: calc(var(--cols) * 212px + (var(--cols) - 1) * 20px);
  }
  .person {
    flex: 0 1 212px;
    text-align: center;
  }
  .photo {
    position: relative;
    display: block;
    aspect-ratio: 20 / 27;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--grey);
    box-shadow: var(--shadow);
    transition: transform 0.25s, box-shadow 0.25s;
  }
  /* Bio card: opens over the portrait on hover or focus (desktop), slightly wider than the
     card so the text is comfortable to read; on phones it slides up from the bottom on tap. */
  .person {
    position: relative;
  }
  button.photo {
    width: 100%;
    padding: 0;
    border: 0;
    cursor: pointer;
    font: inherit;
  }
  .bio-hint {
    position: absolute;
    right: 10px;
    bottom: 10px;
    z-index: 1;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.92);
    color: var(--navy);
    font: 700 0.72rem var(--font-head);
    letter-spacing: 0.04em;
  }
  .bio {
    position: absolute;
    z-index: 20;
    top: -12px;
    left: calc(50% - min(170px, 46vw));
    width: min(340px, 92vw);
    padding: 26px 26px 22px;
    border-radius: var(--radius);
    background: var(--navy);
    color: #fff;
    text-align: left;
    box-shadow: 0 24px 60px rgb(0 28 61 / 0.35);
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px) scale(0.98);
    transition:
      opacity 0.2s,
      transform 0.2s,
      visibility 0.2s;
  }
  .bio p {
    margin: 0 0 14px;
    font-size: 0.9rem;
    line-height: 1.6;
  }
  .bio .bio-name {
    font: 700 1.05rem var(--font-head);
    margin-bottom: 8px;
  }
  .bio a {
    color: #fff;
    font-weight: 700;
    font-size: 0.9rem;
  }
  .bio a:hover {
    color: var(--blue);
  }
  .bio-close {
    display: none;
  }
  @media (hover: hover) {
    .person:hover .bio,
    .person:focus-within .bio {
      opacity: 1;
      visibility: visible;
      transform: none;
    }
  }
  .person.open .bio {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  @media (hover: none), (max-width: 560px) {
    .bio {
      position: fixed;
      top: auto;
      bottom: 0;
      left: 0;
      width: 100%;
      max-height: 75vh;
      overflow-y: auto;
      border-radius: 20px 20px 0 0;
      padding: 28px 24px 32px;
      transform: translateY(100%);
    }
    .person.open .bio {
      transform: none;
    }
    .bio-close {
      display: block;
      position: absolute;
      top: 10px;
      right: 14px;
      border: 0;
      background: none;
      color: #fff;
      font-size: 1.8rem;
      line-height: 1;
      cursor: pointer;
    }
  }
  .person:hover .has-bio,
  a.photo:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
  }
  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .initials {
    display: grid;
    place-items: center;
    height: 100%;
    font: 700 2.6rem var(--font-head);
    color: var(--navy);
  }
  .name {
    margin: 18px 0 4px;
    font-size: 1.08rem;
  }
  .name a {
    color: inherit;
    text-decoration: none;
  }
  .name a:hover {
    color: var(--blue);
  }
  .role {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--muted);
  }
  .alumni-year {
    max-width: 1100px;
    margin: 0 auto 40px;
  }
  .alumni-year h3 {
    font-size: 1.05rem;
    color: var(--blue-dark);
    letter-spacing: 0.04em;
    text-align: center;
    margin-bottom: 20px;
  }
  .alumni {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 28px 20px;
  }
  .alumni li {
    width: 140px;
    text-align: center;
  }
  .alumni a,
  .alumni li > div {
    display: flex;
    flex-direction: column;
    align-items: center;
    color: inherit;
    text-decoration: none;
  }
  .alum-photo {
    display: block;
    width: 112px;
    height: 112px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--grey);
    box-shadow: var(--shadow);
    margin-bottom: 12px;
    transition: transform 0.25s;
  }
  .alumni a:hover .alum-photo {
    transform: translateY(-3px);
  }
  .alum-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .initials.small {
    font-size: 1.6rem;
  }
  .alum-name {
    font: 700 0.92rem/1.3 var(--font-head);
    color: var(--navy);
  }
  .alumni a:hover .alum-name {
    color: var(--blue-dark);
  }
  .alum-role {
    font-size: 0.8rem;
    color: var(--muted);
  }
  @media (max-width: 560px) {
    .team {
      gap: 32px 16px;
    }
    .person {
      flex-basis: calc(50% - 8px);
    }
    .name {
      font-size: 0.98rem;
    }
  }
</style>
