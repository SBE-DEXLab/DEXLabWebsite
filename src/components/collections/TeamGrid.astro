---
import Img from '../Img.astro'
import {getPeople} from '../../lib/queries'
import {brandify} from '../../lib/utils'

interface Props {
  groups: string[]
}
const {groups} = Astro.props
const people = await getPeople(groups)
const titles: Record<string, string> = {core: 'Our Core Team', intern: 'The Interns', associate: 'Affiliated Researchers', alumni: 'Alumni'}
// Every card shows the same three things: portrait, name and role. Hovering over (or tapping) a
// portrait shows the bio on top of it; without a bio the portrait links to LinkedIn.
// Up to five cards per row; bigger groups are split into balanced rows (7 becomes 4 + 3).
const perRow = (n: number) => (n <= 5 ? n : Math.ceil(n / Math.ceil(n / 5)))
---

{
  groups.map((g) => {
    const members = people.filter((p) => p.group === g)
    if (!members.length) return null
    return (
      <div class:list={['group', `group-${g}`]}>
        <h2 class="rule">{titles[g]}</h2>
        <ul class="team" style={`--cols: ${perRow(members.length)}`}>
          {members.map((p) => {
            const photo = p.photo?.url ? (
              <Img image={p.photo} width={400} height={540} sizes="(min-width: 1100px) 230px, 45vw" alt={`Portrait of ${p.name}`} />
            ) : (
              <span class="initials" aria-hidden="true">{p.name.split(' ').map((n) => n[0]).slice(0, 2).join('')}</span>
            )
            return (
              <li class="person">
                {p.bio ? (
                  <div class="photo has-bio" tabindex="0" aria-label={`About ${p.name}`}>
                    {photo}
                    <div class:list={['bio', {long: p.bio.length > 260}]}>
                      <p>{p.bio}</p>
                      {p.linkedin && (
                        <a href={p.linkedin} target="_blank" rel="noopener">
                          LinkedIn
                        </a>
                      )}
                    </div>
                  </div>
                ) : p.linkedin ? (
                  <a class="photo" href={p.linkedin} target="_blank" rel="noopener" title={`${p.name} on LinkedIn`}>
                    {photo}
                  </a>
                ) : (
                  <div class="photo">{photo}</div>
                )}
                <h3 class="name">
                  {p.linkedin ? (
                    <a href={p.linkedin} target="_blank" rel="noopener">
                      {p.name}
                    </a>
                  ) : (
                    p.name
                  )}
                </h3>
                {p.role && <p class="role" set:html={brandify(p.role)} />}
              </li>
            )
          })}
        </ul>
      </div>
    )
  })
}

<style>
  .group + .group {
    margin-top: clamp(64px, 8vw, 104px);
  }
  .group h2 {
    text-align: center;
    margin-bottom: clamp(32px, 4vw, 48px);
  }
  .team {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 40px 20px;
    max-width: calc(var(--cols) * 212px + (var(--cols) - 1) * 20px);
  }
  .person {
    flex: 0 1 212px;
    text-align: center;
  }
  .photo {
    position: relative;
    display: block;
    aspect-ratio: 20 / 27;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--grey);
    box-shadow: var(--shadow);
    transition: transform 0.25s, box-shadow 0.25s;
  }
  .bio {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: safe center;
    gap: 12px;
    padding: 18px;
    background: rgb(0 28 61 / 0.9);
    color: #fff;
    text-align: left;
    overflow-y: auto;
    opacity: 0;
    transition: opacity 0.25s;
  }
  .bio p {
    margin: 0;
    font-size: 0.78rem;
    line-height: 1.5;
  }
  .bio.long {
    padding: 14px 15px;
    gap: 8px;
  }
  .bio.long p {
    font-size: 0.68rem;
    line-height: 1.45;
  }
  .bio a {
    color: #fff;
    font-weight: 700;
    font-size: 0.8rem;
  }
  .bio a:hover {
    color: var(--blue);
  }
  .has-bio {
    cursor: default;
  }
  .has-bio:hover .bio,
  .has-bio:focus-within .bio {
    opacity: 1;
  }
  .has-bio:hover,
  a.photo:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
  }
  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .initials {
    display: grid;
    place-items: center;
    height: 100%;
    font: 700 2.6rem var(--font-head);
    color: var(--navy);
  }
  .name {
    margin: 18px 0 4px;
    font-size: 1.08rem;
  }
  .name a {
    color: inherit;
    text-decoration: none;
  }
  .name a:hover {
    color: var(--blue);
  }
  .role {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--muted);
  }
  @media (max-width: 560px) {
    .team {
      gap: 32px 16px;
    }
    .person {
      flex-basis: calc(50% - 8px);
    }
    .name {
      font-size: 0.98rem;
    }
  }
</style>
