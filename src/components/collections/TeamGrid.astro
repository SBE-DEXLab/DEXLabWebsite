---
import Img from '../Img.astro'
import {getPeople} from '../../lib/queries'
import {brandify} from '../../lib/utils'

interface Props {
  groups: string[]
}
const {groups} = Astro.props
const people = await getPeople(groups)
const titles: Record<string, string> = {core: 'Our Core Team', intern: 'The Interns', associate: 'The Associates', alumni: 'Alumni'}
// Cards as on the old site: portrait with rounded corners and a white pill at the bottom holding
// a navy name tag and the role. Every card shows the same three things: photo, name, role.
// Up to five cards per row; bigger groups are split into balanced rows (7 becomes 4 + 3).
const perRow = (n: number) => (n <= 5 ? n : Math.ceil(n / Math.ceil(n / 5)))
---

{
  groups.map((g) => {
    const members = people.filter((p) => p.group === g)
    if (!members.length) return null
    return (
      <div class:list={['group', `group-${g}`]}>
        <h2 class="rule">{titles[g]}</h2>
        <ul class="team" style={`--cols: ${perRow(members.length)}`}>
          {members.map((p) => {
            const card = (
              <>
                {p.photo?.url ? (
                  <Img image={p.photo} width={340} height={496} sizes="(min-width: 980px) 210px, 45vw" alt={`Portrait of ${p.name}`} />
                ) : (
                  <span class="initials" aria-hidden="true">{p.name.split(' ').map((n) => n[0]).slice(0, 2).join('')}</span>
                )}
                <span class="pill">
                  <span class="name">{p.name}</span>
                  {p.role && <span class="role" set:html={brandify(p.role)} />}
                </span>
              </>
            )
            return (
              <li class="person">
                {p.linkedin ? (
                  <a class="photo" href={p.linkedin} target="_blank" rel="noopener" title={`${p.name} on LinkedIn`}>
                    {card}
                  </a>
                ) : (
                  <div class="photo">{card}</div>
                )}
              </li>
            )
          })}
        </ul>
      </div>
    )
  })
}

<style>
  .group + .group {
    margin-top: clamp(48px, 7vw, 80px);
  }
  .group h2 {
    text-align: center;
    margin-bottom: 32px;
  }
  .team {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    max-width: calc(var(--cols) * 204px + (var(--cols) - 1) * 16px);
    margin-inline: auto;
  }
  .person {
    flex: 0 1 204px;
  }
  .photo {
    position: relative;
    display: block;
    aspect-ratio: 312 / 455;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--grey);
    box-shadow: var(--shadow);
    text-decoration: none;
  }
  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .initials {
    display: grid;
    place-items: center;
    height: 100%;
    font: 700 2.6rem var(--font-head);
    color: var(--navy);
  }
  .pill {
    position: absolute;
    left: 8px;
    right: 8px;
    bottom: 10px;
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 34px;
    padding: 4px 10px 4px 4px;
    background: #fff;
    border-radius: 999px;
  }
  .name {
    flex: none;
    white-space: nowrap;
    background: var(--navy);
    color: #fff;
    border-radius: 999px;
    padding: 5px 10px;
    font: 700 0.7rem/1.2 var(--font-head);
  }
  .role {
    flex: 1;
    min-width: 0;
    font-size: 0.62rem;
    line-height: 1.25;
    color: var(--navy);
  }
  @media (max-width: 520px) {
    .person {
      flex-basis: calc(50% - 8px);
    }
    .pill {
      flex-direction: column;
      align-items: stretch;
      border-radius: 14px;
      padding: 4px;
      gap: 3px;
    }
    .name {
      white-space: normal;
      text-align: center;
    }
    .role {
      text-align: center;
      padding-bottom: 2px;
    }
  }
</style>
