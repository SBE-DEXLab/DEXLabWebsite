---
import {getFaqs} from '../../lib/queries'
import {renderRichText} from '../../lib/portableText'
import {brandify} from '../../lib/utils'

interface Props {
  limit?: number
}
const all = await getFaqs()
const faqs = Astro.props.limit ? all.slice(0, Astro.props.limit) : all
// As on the old site: every question with its answer in a grey box, two columns on wide screens.
---

<div class="faq">
  {
    faqs.map((f) => (
      <article class="item panel">
        <h3 set:html={brandify(f.question)} />
        <div class="prose" set:html={renderRichText(f.answer)} />
      </article>
    ))
  }
</div>

<style>
  .faq {
    columns: 2 380px;
    column-gap: 28px;
  }
  .item {
    break-inside: avoid;
    padding: 22px 24px;
    margin-bottom: 28px;
  }
  .item h3 {
    font-size: 1.25rem;
  }
  .item :global(.prose) {
    font-size: 0.92rem;
  }
</style>
