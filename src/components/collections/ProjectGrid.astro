---
import Img from '../Img.astro'
import {getProjects} from '../../lib/queries'
import type {Project} from '../../lib/types'

// Current projects first, then completed ones; within each, the editor's order.
const projects = (await getProjects()).sort((a, b) => Number(a.status === 'completed') - Number(b.status === 'completed'))
const labels: Record<Project['category'], {badge: string; filter: string}> = {
  research: {badge: 'Research', filter: 'Research'},
  phd: {badge: 'PhD project', filter: 'PhD projects'},
  education: {badge: 'Education', filter: 'Education'},
  network: {badge: 'Network', filter: 'Networks'},
}
const filters = (Object.keys(labels) as Project['category'][])
  .map((c) => ({value: c, label: labels[c].filter, count: projects.filter((p) => p.category === c).length}))
  .filter((f) => f.count > 0)
const status = (p: Project) => [p.status === 'completed' ? 'Completed' : 'Current', p.period].filter(Boolean).join(' · ')
---

{
  projects.length > 0 && (
    <div class="projects" data-projects>
      {/* Filters need JavaScript; without it every card simply shows. */}
      <div class="filters" role="group" aria-label="Filter projects" hidden data-filters>
        <button type="button" aria-pressed="true" data-filter="all">
          All <span class="count">{projects.length}</span>
        </button>
        {filters.map((f) => (
          <button type="button" aria-pressed="false" data-filter={f.value}>
            {f.label} <span class="count">{f.count}</span>
          </button>
        ))}
      </div>
      <p class="visually-hidden" aria-live="polite" data-status />

      <ul class="grid-projects">
        {projects.map((p) => (
          <li class="project" data-category={p.category}>
            <div class:list={['cover', !p.cover?.url && (p.coverColor || 'navy')]}>
              {p.cover?.url && (
                <Img image={p.cover} width={720} height={405} sizes="(min-width: 1180px) 400px, (min-width: 700px) 50vw, 100vw" alt="" />
              )}
            </div>
            <div class="body">
              <p class="meta">
                <span class="badge">{labels[p.category].badge}</span>
                <span class:list={['status', p.status]}>{status(p)}</span>
              </p>
              {p.partners && (
                <p class="partners">
                  <span class="visually-hidden">Partners: </span>
                  {p.partners}
                </p>
              )}
              <h3>{p.title}</h3>
              {p.description && <p class="desc">{p.description}</p>}
              {p.tags?.length ? (
                <ul class="tags" aria-label="Topics">
                  {p.tags.map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
              ) : null}
              {p.team?.length ? (
                <p class="team">
                  <span class="label">Team</span> {p.team.join(', ')}
                </p>
              ) : null}
              {p.link && (
                <a class="more" href={p.link} target="_blank" rel="noopener">
                  Learn more<span class="visually-hidden"> about {p.title} (opens in a new tab)</span>{' '}
                  <span aria-hidden="true">→</span>
                </a>
              )}
            </div>
          </li>
        ))}
      </ul>
    </div>
  )
}

<script>
  document.querySelectorAll<HTMLElement>('[data-projects]').forEach((root) => {
    const bar = root.querySelector<HTMLElement>('[data-filters]')!
    const live = root.querySelector<HTMLElement>('[data-status]')!
    const buttons = [...bar.querySelectorAll<HTMLButtonElement>('button')]
    const cards = [...root.querySelectorAll<HTMLElement>('.project')]
    bar.hidden = false
    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        const f = b.dataset.filter
        buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)))
        let shown = 0
        cards.forEach((c) => {
          c.hidden = f !== 'all' && c.dataset.category !== f
          if (!c.hidden) shown++
        })
        live.textContent = `Showing ${shown} ${shown === 1 ? 'project' : 'projects'}`
      }),
    )
  })
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin: 0 0 clamp(32px, 4vw, 48px);
  }
  .filters[hidden] {
    display: none;
  }
  .filters button {
    font: 700 0.9rem/1 var(--font-head);
    color: var(--navy);
    background: var(--white);
    border: 1.5px solid var(--line-light);
    border-radius: 999px;
    padding: 11px 18px;
    cursor: pointer;
    transition:
      border-color 0.2s,
      background 0.2s,
      color 0.2s;
  }
  .filters button:hover {
    border-color: var(--navy);
  }
  .filters button[aria-pressed='true'] {
    background: var(--navy);
    border-color: var(--navy);
    color: var(--white);
  }
  .filters .count {
    font-weight: 600;
    opacity: 0.7;
    margin-left: 4px;
  }
  .grid-projects {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(20px, 2.4vw, 32px);
  }
  .project {
    display: flex;
    flex-direction: column;
    background: var(--white);
    border: 1px solid var(--line-light);
    border-radius: var(--radius);
    overflow: hidden;
    transition:
      transform 0.25s,
      box-shadow 0.25s;
  }
  .project[hidden] {
    display: none;
  }
  .project:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
  }
  .cover {
    aspect-ratio: 16 / 9;
    background: var(--grey);
  }
  .cover.navy {
    background: var(--navy);
  }
  .cover.azure {
    background: var(--azure);
  }
  .cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 22px 24px 26px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
    margin: 0 0 12px;
    font-size: 0.8rem;
  }
  .badge {
    font: 700 0.72rem/1 var(--font-head);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--navy);
    background: var(--blue-tint);
    border-left: 3px solid var(--blue);
    padding: 6px 9px;
    border-radius: var(--radius-sm);
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--navy);
    font-weight: 600;
  }
  .status::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--line-light);
  }
  .status.current::before {
    background: var(--orange);
  }
  .partners {
    margin: 0 0 6px;
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--muted);
  }
  h3 {
    font-size: 1.12rem;
    line-height: 1.35;
    margin: 0 0 10px;
  }
  .desc {
    margin: 0 0 16px;
    font-size: 0.92rem;
    line-height: 1.6;
  }
  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 0 16px;
    padding: 0;
  }
  .tags li {
    font-size: 0.75rem;
    line-height: 1;
    color: var(--navy);
    border: 1px solid var(--line-light);
    border-radius: 999px;
    padding: 6px 10px;
  }
  .team {
    margin: auto 0 0;
    padding-top: 14px;
    border-top: 1px solid var(--line-light);
    font-size: 0.82rem;
    line-height: 1.5;
  }
  .team .label {
    font: 700 0.72rem var(--font-head);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-right: 4px;
  }
  .more {
    align-self: flex-start;
    margin-top: 16px;
    font: 700 0.9rem var(--font-head);
    color: var(--navy);
    text-decoration-color: var(--blue);
    text-decoration-thickness: 2px;
  }
  .more:hover {
    color: var(--blue-dark);
  }
  @media (max-width: 1000px) {
    .grid-projects {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 680px) {
    .grid-projects {
      grid-template-columns: 1fr;
    }
    /* a plain colour block needs no photo height on a phone */
    .cover.navy,
    .cover.azure {
      aspect-ratio: 16 / 4;
    }
  }
</style>
