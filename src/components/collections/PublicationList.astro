---
import {getPublications} from '../../lib/queries'

const pubs = await getPublications()
const years = [...new Set(pubs.map((p) => p.year))].sort((a, b) => b - a)
const kinds: Record<string, string> = {
  article: 'Journal article',
  chapter: 'Book chapter',
  conference: 'Conference paper',
  thesis: 'Thesis',
  other: 'Other',
}
// Lab members are highlighted in author lists.
const members = ['Heller, J.', 'Hilken, T.', 'Mahr, D.', 'Di Palma, R.', 'Becker, M.', 'Briker, R.', 'Steins, M.', 'Mennens, K.', 'Krispin, A.', 'Mariş, A.']
const highlight = (authors: string) => {
  let html = authors.replace(/[&<>]/g, (c) => ({'&': '&amp;', '<': '&lt;', '>': '&gt;'})[c]!)
  for (const m of members) html = html.split(m).join(`<strong>${m}</strong>`)
  return html
}
---

<div class="pubs" data-pubs>
  <div class="toolbar">
    <label class="search">
      <span class="visually-hidden">Search publications</span>
      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" d="M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14zm9 16-4-4" /></svg>
      <input type="search" placeholder="Search by title, author or journal" data-search />
    </label>
    <label class="filter">
      <span class="visually-hidden">Filter by year</span>
      <select data-year>
        <option value="">All years</option>
        {years.map((y) => <option value={y}>{y}</option>)}
      </select>
    </label>
    <p class="count" aria-live="polite"><span data-count>{pubs.length}</span> publications</p>
  </div>

  {
    years.map((year) => (
      <section class="year" data-year-group={year}>
        <h2 class="year-title">{year}</h2>
        <ol class="list">
          {pubs
            .filter((p) => p.year === year)
            .map((p) => (
              <li class="pub" data-text={`${p.title} ${p.authors} ${p.venue || ''}`.toLowerCase()}>
                <p class="authors" set:html={highlight(p.authors)} />
                <h3 class="title">
                  {p.url ? (
                    <a href={p.url} target="_blank" rel="noopener">
                      {p.title}
                    </a>
                  ) : (
                    p.title
                  )}
                </h3>
                <p class="venue">
                  {p.venue && <em>{p.venue}</em>}
                  {p.kind && p.kind !== 'article' && <span class="chip">{kinds[p.kind]}</span>}
                  {p.url && (
                    <a class="doi" href={p.url} target="_blank" rel="noopener">
                      {p.url.includes('doi.org') ? 'DOI' : 'Link'} <span aria-hidden="true">↗</span>
                    </a>
                  )}
                </p>
              </li>
            ))}
        </ol>
      </section>
    ))
  }
  <p class="empty" hidden data-empty>No publications match your search.</p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-pubs]').forEach((root) => {
    const search = root.querySelector<HTMLInputElement>('[data-search]')!
    const year = root.querySelector<HTMLSelectElement>('[data-year]')!
    const count = root.querySelector('[data-count]')!
    const empty = root.querySelector<HTMLElement>('[data-empty]')!
    const update = () => {
      const q = search.value.trim().toLowerCase()
      let total = 0
      root.querySelectorAll<HTMLElement>('[data-year-group]').forEach((g) => {
        const yearOk = !year.value || g.dataset.yearGroup === year.value
        let visible = 0
        g.querySelectorAll<HTMLElement>('.pub').forEach((li) => {
          const ok = yearOk && (!q || li.dataset.text!.includes(q))
          li.hidden = !ok
          if (ok) visible++
        })
        g.hidden = visible === 0
        total += visible
      })
      count.textContent = String(total)
      empty.hidden = total > 0
    }
    search.addEventListener('input', update)
    year.addEventListener('change', update)
  })
</script>

<style>
  .pubs {
    max-width: 900px;
    margin: 0 auto;
  }
  .toolbar {
    position: sticky;
    top: calc(var(--header-h) + 8px);
    z-index: 5;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    background: rgb(255 255 255 / 0.94);
    backdrop-filter: blur(8px);
    padding: 12px;
    border-radius: 0;
    box-shadow: none;
    margin-bottom: 40px;
  }
  .search {
    flex: 1 1 280px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 14px;
    border: 1.5px solid var(--line);
    border-radius: 0;
    color: var(--muted);
  }
  .search:focus-within {
    border-color: var(--blue);
  }
  .search input {
    flex: 1;
    border: 0;
    font: inherit;
    padding: 10px 0;
    outline: none;
    min-width: 0;
  }
  select {
    font: inherit;
    padding: 10px 14px;
    border: 1.5px solid var(--line);
    border-radius: 0;
    background: #fff;
  }
  .count {
    margin: 0 8px 0 auto;
    color: var(--muted);
    font-size: 0.92rem;
  }
  .year {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 24px;
    padding-block: 24px;
    border-top: 1px solid var(--line);
  }
  .year-title {
    font-size: 2rem;
    color: var(--blue);
    position: sticky;
    top: calc(var(--header-h) + 100px);
    align-self: start;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 22px;
  }
  .pub p {
    margin: 0;
  }
  .authors {
    font-size: 0.92rem;
    color: var(--muted);
  }
  .authors :global(strong) {
    color: var(--navy);
  }
  .title {
    font-size: 1.08rem;
    font-weight: 700;
    margin: 4px 0;
    line-height: 1.4;
  }
  .title a {
    color: var(--navy);
    text-decoration: none;
  }
  .title a:hover {
    color: var(--blue-dark);
    text-decoration: underline;
  }
  .venue {
    font-size: 0.92rem;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 12px;
    align-items: center;
  }
  .doi {
    font-weight: 600;
    text-decoration: none;
    font-size: 0.85rem;
  }
  .empty {
    text-align: center;
    color: var(--muted);
  }
  @media (max-width: 640px) {
    .year {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .year-title {
      position: static;
    }
  }
</style>
