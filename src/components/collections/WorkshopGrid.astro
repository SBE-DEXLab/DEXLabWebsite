---
import Img from '../Img.astro'
import {getWorkshops, getSettings} from '../../lib/queries'

interface Props {
  limit?: number
}
const {limit} = Astro.props
const [all, settings] = await Promise.all([getWorkshops(), getSettings()])
const workshops = limit ? all.slice(0, limit) : all
const email = settings?.email || 'sbe-dexlab@maastrichtuniversity.nl'
const href = (w: (typeof all)[number]) =>
  w.externalOnly ? `mailto:${email}?subject=${encodeURIComponent(w.contactSubject || w.title)}` : `/workshops/${w.slug}`
---

<div class="grid" style="--cols: 3">
  {
    workshops.map((w) => (
      <article class="card panel">
        <a class="card-media" href={href(w)} tabindex="-1" aria-hidden="true">
          <Img image={w.cardImage} width={600} height={498} sizes="(min-width: 1180px) 360px, (min-width: 600px) 50vw, 100vw" alt="" />
        </a>
        <div class="card-body">
          <h3>{w.title}</h3>
          {w.summary && <p>{w.summary}</p>}
          <a class="btn blue" href={href(w)}>{w.externalOnly ? 'Contact us' : 'Read more'}</a>
        </div>
      </article>
    ))
  }
</div>

<style>
  .card-media {
    aspect-ratio: 403 / 334;
  }
  .card-body .btn {
    margin-top: 14px;
  }
</style>
