---
import type {Settings} from '../lib/types'

interface Props {
  settings: Settings | null
}
const {settings} = Astro.props
const nav = settings?.navigation || []
const path = Astro.url.pathname.replace(/\/$/, '') || '/'
const matches = (href: string) => href === path || (href !== '/' && path.startsWith(href + '/'))
const isActive = (href: string, children?: {href: string}[]) => matches(href) || Boolean(children?.some((c) => matches(c.href)))
const announcement = settings?.announcement
---

{
  announcement?.enabled && announcement.text && (
    <div class="announcement">
      {announcement.link ? <a href={announcement.link}>{announcement.text}</a> : <span>{announcement.text}</span>}
    </div>
  )
}
<header class="site-header" data-header>
  <div class="container wide bar">
    <a href="/" class="logo" aria-label="DEXLab home">
      <img src="/brand/dexlab-logo-header.png" alt="DEXLab" width="110" height="64" />
    </a>

    <button class="menu-toggle" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
      <span class="visually-hidden">Menu</span>
      <span class="burger" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>

    <nav id="site-nav" class="nav" aria-label="Main" data-nav>
      <ul class="nav-list">
        {
          nav.map((item) =>
            item.children?.length ? (
              <li class="has-sub" data-sub>
                <a href={item.href} class:list={['nav-link', {active: isActive(item.href, item.children)}]} aria-current={item.href === path ? 'page' : undefined}>
                  {item.label}
                </a>
                <button class="sub-toggle" aria-expanded="false" aria-label={`${item.label} submenu`} data-sub-toggle>
                  <svg width="10" height="10" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.8" /></svg>
                </button>
                <ul class="sub">
                  {item.children.map((c) => (
                    <li>
                      <a href={c.href} aria-current={c.href === path ? 'page' : undefined}>{c.label}</a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li>
                <a href={item.href} class:list={['nav-link', {active: isActive(item.href)}]} aria-current={item.href === path ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!
  const toggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]')!
  // Slightly smaller header once the page is scrolled
  const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 40)
  onScroll()
  window.addEventListener('scroll', onScroll, {passive: true})
  const setOpen = (open: boolean) => {
    toggle.setAttribute('aria-expanded', String(open))
    header.classList.toggle('open', open)
    document.body.style.overflow = open ? 'hidden' : ''
  }
  toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'))
  header.querySelectorAll<HTMLButtonElement>('[data-sub-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const li = btn.closest('[data-sub]')!
      const open = !li.classList.contains('sub-open')
      header.querySelectorAll('[data-sub]').forEach((el) => el.classList.remove('sub-open'))
      li.classList.toggle('sub-open', open)
      btn.setAttribute('aria-expanded', String(open))
    })
  })
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return
    setOpen(false)
    header.querySelectorAll('[data-sub]').forEach((el) => el.classList.remove('sub-open'))
  })
</script>

<style>
  .announcement {
    background: var(--navy);
    color: #fff;
    text-align: center;
    font-size: 0.9rem;
    padding: 8px var(--gutter);
  }
  .announcement a {
    color: #fff;
    font-weight: 600;
  }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--peach);
  }
  .site-header {
    transition: box-shadow 0.25s;
  }
  .site-header.scrolled {
    box-shadow: 0 4px 18px rgb(0 28 61 / 0.08);
    background: color-mix(in srgb, var(--peach) 78%, transparent);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 28px;
    height: var(--header-h);
    transition: height 0.25s;
  }
  .scrolled .bar {
    height: 74px;
  }
  .logo img {
    height: 64px;
    width: auto;
    transition: height 0.25s;
  }
  .scrolled .logo img {
    height: 50px;
  }
  .nav {
    margin-left: auto;
  }
  .nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
  }
  .nav-list > li {
    position: relative;
    display: flex;
    align-items: center;
  }
  .nav-link {
    display: block;
    padding: 10px 13px;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.76rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--navy);
    transition: color 0.15s;
    text-decoration: none;
    white-space: nowrap;
  }
  .nav-link:hover,
  .nav-link.active {
    color: var(--blue);
  }
  .sub-toggle {
    display: none;
    background: none;
    border: 0;
    padding: 8px;
    color: #000;
    cursor: pointer;
  }
  .sub {
    list-style: none;
    margin: 0;
    padding: 10px 0;
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 270px;
    background: #fff;
    border-radius: 10px;
    box-shadow: var(--shadow);
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 0.18s, visibility 0.18s, transform 0.18s;
  }
  .has-sub:hover .sub,
  .has-sub:focus-within .sub {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  .sub a {
    display: block;
    padding: 10px 20px;
    color: var(--navy);
    text-decoration: none;
    font-size: 0.92rem;
  }
  .sub a:hover,
  .sub a[aria-current='page'] {
    color: var(--blue);
  }
  .menu-toggle {
    display: none;
    margin-left: auto;
    background: none;
    border: 0;
    padding: 10px;
    cursor: pointer;
    color: var(--navy);
  }
  .burger {
    display: grid;
    gap: 5px;
    width: 26px;
  }
  .burger span {
    height: 2px;
    background: currentColor;
    transition: transform 0.25s, opacity 0.25s;
  }
  .open .burger span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .open .burger span:nth-child(2) {
    opacity: 0;
  }
  .open .burger span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (max-width: 1240px) {
    .menu-toggle {
      display: block;
    }
    .nav {
      position: fixed;
      inset: var(--header-h) 0 0;
      background: var(--peach);
      overflow-y: auto;
      padding: 8px var(--gutter) 40px;
      display: none;
      margin: 0;
    }
    .open .nav {
      display: block;
    }
    .scrolled .nav {
      top: 74px;
    }
    .nav-list {
      flex-direction: column;
      align-items: stretch;
    }
    .nav-list > li {
      flex-wrap: wrap;
      border-bottom: 1px solid rgb(0 28 61 / 0.12);
    }
    .nav-link {
      flex: 1;
      padding: 15px 4px;
      font-size: 0.95rem;
    }
    .sub-toggle {
      display: block;
    }
    .sub {
      position: static;
      width: 100%;
      box-shadow: none;
      background: transparent;
      border-radius: 0;
      transform: none;
      padding: 0 0 10px 14px;
      display: none;
      opacity: 1;
      visibility: visible;
    }
    .has-sub:hover .sub,
    .has-sub:focus-within .sub {
      display: none;
    }
    .has-sub.sub-open .sub {
      display: block;
    }
    .sub a {
      font-size: 0.88rem;
    }
  }
</style>
