---
// Click-to-play YouTube video. The thumbnail is fetched once at build time and inlined, so a visitor's
// browser contacts YouTube (privacy-enhanced youtube-nocookie.com) only after they press play.
interface Props {
  id: string
  title?: string
}
const {id, title = 'Video'} = Astro.props

const cache = ((globalThis as any).__ytThumbs ??= new Map<string, Promise<string | undefined>>())
if (!cache.has(id)) {
  cache.set(
    id,
    fetch(`https://i.ytimg.com/vi/${id}/hqdefault.jpg`)
      .then(async (r) => (r.ok ? `data:image/jpeg;base64,${Buffer.from(await r.arrayBuffer()).toString('base64')}` : undefined))
      .catch(() => undefined),
  )
}
const thumb: string | undefined = await cache.get(id)
---

<div class="video-frame yt" data-yt={id} data-title={title}>
  <button type="button" aria-label={`Play video: ${title}`}>
    {thumb && <img src={thumb} alt="" loading="lazy" decoding="async" />}
    <span class="play" aria-hidden="true">
      <svg width="28" height="28" viewBox="0 0 24 24"><path fill="currentColor" d="M8 5v14l11-7z" /></svg>
    </span>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-yt]').forEach((el) =>
    el.querySelector('button')?.addEventListener('click', () => {
      const f = document.createElement('iframe')
      f.src = `https://www.youtube-nocookie.com/embed/${el.dataset.yt}?autoplay=1`
      f.title = el.dataset.title || 'Video'
      f.allow = 'accelerometer; autoplay; encrypted-media; picture-in-picture; fullscreen'
      f.allowFullscreen = true
      el.replaceChildren(f)
    }),
  )
</script>

<style>
  .yt {
    border-radius: var(--radius);
    background: var(--navy);
  }
  .yt button {
    position: absolute;
    inset: 0;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .yt img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s;
  }
  .yt button:hover img {
    transform: scale(1.03);
  }
  .play {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: var(--blue-dark);
    color: #fff;
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.3);
    transition: transform 0.2s;
  }
  .yt button:hover .play {
    transform: scale(1.08);
  }
</style>
