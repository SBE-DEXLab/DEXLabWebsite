---
import type {Settings} from '../lib/types'
import {brandify} from '../lib/utils'
import SocialIcon from './SocialIcon.astro'

interface Props {
  settings: Settings | null
}
const {settings} = Astro.props
const nl = settings?.newsletter
const year = new Date().getFullYear()
const address = (settings?.address || '').split('\n').filter((l) => l && l !== 'The Netherlands').join(', ')
---

<footer class="site-footer">
  <div class="container wide top">
    <div class="logos">
      <a href="/" aria-label="DEXLab home"><img src="/brand/dexlab-logo-full.png" alt="DEXLab, Digital Experience Laboratory" width="120" height="92" loading="lazy" /></a>
      <a href="https://www.maastrichtuniversity.nl/about-um/faculties/school-business-and-economics" target="_blank" rel="noopener">
        <img src="/brand/um-sbe-logo.png" alt="Maastricht University School of Business and Economics" width="220" height="55" loading="lazy" />
      </a>
    </div>
    <div class="follow">
      <p class="follow-title">Follow us:</p>
      <ul class="socials">
        {
          settings?.socials?.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener" aria-label={s.platform}>
                <SocialIcon platform={s.platform} size={18} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  {
    nl?.enabled !== false && (
      <form class="container newsletter" name="newsletter" method="POST" action="/thanks/?form=newsletter" data-netlify="true" netlify-honeypot="company">
        <h2 set:html={brandify(nl?.heading || 'Join DEXLab mailing list')} />
        <input type="hidden" name="form-name" value="newsletter" />
        <p class="hp">
          <label>
            Leave this empty <input name="company" tabindex="-1" autocomplete="off" />
          </label>
        </p>
        <div class="nl-row">
          <div class="field">
            <label for="nl-email">Email *</label>
            <input id="nl-email" type="email" name="email" autocomplete="email" required />
          </div>
          <button class="btn" type="submit">Subscribe</button>
        </div>
        <label class="check">
          <input type="checkbox" name="consent" value="yes" required />
          <span>I agree that DEXLab stores my email address to send me news (see the <a href="/privacy">privacy statement</a>).</span>
        </label>
      </form>
    )
  }

  <div class="container bottom">
    <p>
      <span class="brand-dex">DEX</span><span class="brand-lab">Lab</span> - {address}<br />
      {settings?.email && <a href={`mailto:${settings.email}`}>{settings.email}</a>}
    </p>
    <p class="copy">
      © {year} DEXLab{settings?.footerNote && <> | {settings.footerNote}</>} | <a href="/privacy">Privacy</a> | <a href="/admin" rel="nofollow">Admin</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--grey);
    border-top: 2px solid #d4d6d9;
    padding-top: 36px;
    font-size: 0.85rem;
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
  }
  .logos {
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .logos a:first-child img {
    width: 110px;
    height: auto;
  }
  .logos a:last-child img {
    width: 190px;
    height: auto;
  }
  .follow-title {
    font-family: var(--font-head);
    font-weight: 700;
    margin: 0 0 8px;
  }
  .socials {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 8px;
  }
  .socials a {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 4px;
    background: var(--navy);
    color: #fff;
  }
  .socials a:hover {
    background: var(--blue);
  }
  .newsletter {
    max-width: 560px;
    padding-block: 8px 24px;
  }
  .newsletter h2 {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 1.15rem;
    margin: 0 0 10px;
  }
  .nl-row {
    display: flex;
    align-items: flex-end;
    gap: 14px;
    margin-bottom: 10px;
  }
  .nl-row .field {
    flex: 1;
  }
  .nl-row input {
    background: transparent;
  }
  .nl-row .btn {
    min-width: 96px;
    padding-block: 12px;
  }
  .bottom {
    text-align: center;
    padding-bottom: 14px;
  }
  .bottom p {
    margin: 0 0 10px;
  }
  .bottom a {
    color: var(--navy);
  }
  .copy {
    border-top: 1px solid var(--navy);
    padding-top: 8px;
  }
  @media (max-width: 640px) {
    .top {
      flex-direction: column;
    }
    .logos {
      flex-wrap: wrap;
    }
    .nl-row {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
