---
import Img from './Img.astro'
import {formatDate} from '../lib/utils'
import type {PostCard} from '../lib/types'

interface Props {
  post: PostCard
  /** tile = square photo with the title on it ("Latest news" on the old site); card = photo, date and excerpt */
  variant?: 'tile' | 'card'
}
const {post, variant = 'card'} = Astro.props
---

{
  variant === 'tile' ? (
    <a class="tile" href={`/post/${post.slug}`}>
      <Img image={post.coverImage} width={420} height={420} sizes="(min-width: 980px) 300px, (min-width: 600px) 45vw, 100vw" alt="" />
      <span class="tile-title">{post.title}</span>
    </a>
  ) : (
    <article class="post-card">
      <a href={`/post/${post.slug}`} class="media" tabindex="-1" aria-hidden="true">
        <Img image={post.coverImage} width={480} height={320} sizes="(min-width: 980px) 360px, (min-width: 600px) 50vw, 100vw" alt="" />
      </a>
      <div class="body">
        <p class="meta">
          <time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time>
          {post.categories?.[0] && <> · <a href={`/blog/categories/${post.categories[0].slug}`}>{post.categories[0].title}</a></>}
        </p>
        <h3><a href={`/post/${post.slug}`}>{post.title}</a></h3>
        {post.excerpt && <p class="excerpt">{post.excerpt}</p>}
      </div>
    </article>
  )
}

<style>
  .tile {
    position: relative;
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--navy);
    text-decoration: none;
  }
  .tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s;
  }
  .tile::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(0 0 0 / 0.05) 35%, rgb(0 0 0 / 0.6));
  }
  .tile:hover :global(img) {
    transform: scale(1.04);
  }
  .tile-title {
    position: absolute;
    z-index: 1;
    left: 18px;
    right: 18px;
    bottom: 16px;
    color: #fff;
    font: 700 1.25rem/1.3 var(--font-head);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .post-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--grey);
    background: #fff;
  }
  .media {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--grey);
  }
  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .body {
    padding: 18px 20px 22px;
  }
  .meta {
    font-size: 0.8rem;
    margin: 0 0 6px;
  }
  .meta a {
    color: var(--blue);
    text-decoration: none;
  }
  h3 {
    font-size: 1.1rem;
    margin: 0 0 8px;
  }
  h3 a {
    color: var(--navy);
    text-decoration: none;
  }
  h3 a:hover {
    color: var(--blue);
  }
  .excerpt {
    font-size: 0.92rem;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
