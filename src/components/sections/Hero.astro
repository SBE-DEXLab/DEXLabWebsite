---
import Img from '../Img.astro'
import Buttons from '../Buttons.astro'
import {brandify} from '../../lib/utils'
import type {Img as ImgT, Link} from '../../lib/types'

interface Props {
  heading: string
  eyebrow?: string
  subheading?: string
  image?: ImgT
  layout?: 'overlay' | 'banner' | 'plain'
  buttons?: Link[]
  first?: boolean
}
// As on the old site: an optional full-width photo banner, then the centred heading,
// intro text and buttons on white. The "overlay" layout is kept for editors who want it.
const {heading, eyebrow, subheading, image, buttons, first = true} = Astro.props
const layout = image?.url ? Astro.props.layout || 'banner' : 'plain'
const H = first ? 'h1' : 'h2'
const focus = image?.hotspot ? `${image.hotspot.x * 100}% ${image.hotspot.y * 100}%` : '50% 30%'
---

<section class:list={['hero', layout]}>
  {
    layout !== 'plain' && (
      <div class="banner-img">
        <Img image={image} width={1800} fit="max" eager={first} style={`object-position: ${focus}`} />
      </div>
    )
  }
  <div class="container text">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <H set:html={brandify(heading)} />
    {subheading && <p class="lead">{subheading}</p>}
    <Buttons buttons={buttons} center />
  </div>
</section>

<style>
  .hero {
    text-align: center;
  }
  .banner-img {
    height: clamp(200px, 33vw, 470px);
    overflow: hidden;
    background: var(--grey);
  }
  .banner-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .text {
    padding-block: clamp(28px, 4vw, 44px) 8px;
    max-width: 820px;
  }
  .plain .text {
    padding-top: clamp(36px, 5vw, 56px);
  }
  .text :global(h1),
  .text :global(h2) {
    margin-bottom: 14px;
  }
  .lead {
    font-size: 1rem;
    margin: 0 auto;
    max-width: 740px;
  }
</style>
