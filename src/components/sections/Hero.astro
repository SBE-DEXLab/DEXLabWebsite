---
import Img from '../Img.astro'
import Buttons from '../Buttons.astro'
import {brandify} from '../../lib/utils'
import type {Img as ImgT, Link} from '../../lib/types'

interface Props {
  heading: string
  eyebrow?: string
  subheading?: string
  image?: ImgT
  layout?: 'overlay' | 'banner' | 'plain' | 'split'
  buttons?: Link[]
  first?: boolean
}
// As on the old site: an optional full-width photo banner, then the centred heading,
// intro text and buttons on white. The "overlay" layout is kept for editors who want it.
const {heading, eyebrow, subheading, image, buttons, first = true} = Astro.props
const layout = image?.url ? Astro.props.layout || 'banner' : 'plain'
const H = first ? 'h1' : 'h2'
const focus = image?.hotspot ? `${image.hotspot.x * 100}% ${image.hotspot.y * 100}%` : '50% 30%'
---

{
  layout === 'split' ? (
    <section class="hero split">
      <div class="container wide split-grid">
        <div class="split-text">
          {eyebrow && <span class="eyebrow">{eyebrow}</span>}
          <H set:html={brandify(heading)} />
          {subheading && <p class="split-lead">{subheading}</p>}
          <Buttons buttons={buttons} />
        </div>
        <figure class="split-photo">
          <Img image={image} width={1100} height={760} sizes="(min-width: 980px) 640px, 100vw" eager={first} style={`object-position: ${focus}`} />
        </figure>
      </div>
    </section>
  ) : (
<section class:list={['hero', layout]}>
  {
    layout !== 'plain' && (
      <div class="banner-img">
        <Img image={image} width={1800} fit="max" eager={first} style={`object-position: ${focus}`} />
      </div>
    )
  }
  <div class="container text">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <H set:html={brandify(heading)} />
    {subheading && <p class:list={['lead', {long: subheading.length > 220}]}>{subheading}</p>}
    <Buttons buttons={buttons} center />
  </div>
</section>
  )
}

<style>
  .hero {
    text-align: center;
  }
  /* Landing page: text left, photo right, on a soft peach fade that continues the header */
  .hero.split {
    position: relative;
    isolation: isolate;
    text-align: left;
    background: linear-gradient(var(--peach), #fff 85%);
    padding-block: clamp(40px, 6vw, 88px) clamp(24px, 3vw, 40px);
    overflow: hidden;
  }
  /* soft brand-coloured glows drifting behind the headline */
  .hero.split::before,
  .hero.split::after {
    content: '';
    position: absolute;
    z-index: -1;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.35;
    animation: drift 18s ease-in-out infinite alternate;
  }
  .hero.split::before {
    width: 520px;
    height: 520px;
    left: -160px;
    top: -120px;
    background: var(--blue);
  }
  .hero.split::after {
    width: 380px;
    height: 380px;
    left: 30%;
    bottom: -180px;
    background: var(--orange);
    opacity: 0.22;
    animation-duration: 22s;
    animation-direction: alternate-reverse;
  }
  @keyframes drift {
    to {
      transform: translate(80px, 50px) scale(1.12);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero.split::before,
    .hero.split::after {
      animation: none;
    }
  }
  .split-grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
  }
  .split-text :global(h1) {
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    line-height: 1.08;
    margin-bottom: 24px;
  }
  .split-lead {
    font-size: clamp(1.02rem, 1.4vw, 1.15rem);
    line-height: 1.75;
    color: var(--muted);
    margin: 0;
    max-width: 560px;
  }
  .split-photo {
    position: relative;
    margin: 0;
  }
  .split-photo::before,
  .split-photo::after {
    content: '';
    position: absolute;
    border-radius: 24px;
    z-index: 0;
  }
  .split-photo::before {
    inset: -18px 40px 48px -18px;
    background: var(--blue);
    opacity: 0.9;
  }
  .split-photo::after {
    width: 120px;
    height: 120px;
    right: -22px;
    bottom: -22px;
    background: var(--orange);
  }
  .split-photo :global(img) {
    position: relative;
    z-index: 1;
    width: 100%;
    aspect-ratio: 11 / 7.6;
    object-fit: cover;
    border-radius: 24px;
    box-shadow: var(--shadow-hover);
  }
  @media (max-width: 900px) {
    .split-grid {
      grid-template-columns: 1fr;
    }
    .split-photo {
      order: -1;
      margin: 0 12px 12px;
    }
  }
  /* banner photos sit inset with rounded corners rather than edge to edge */
  .banner-img {
    height: clamp(220px, 32vw, 460px);
    max-width: var(--max-wide);
    margin: clamp(16px, 2.5vw, 32px) auto 0;
    width: calc(100% - 2 * var(--gutter));
    border-radius: 24px;
    overflow: hidden;
    background: var(--grey);
    box-shadow: var(--shadow);
  }
  .banner-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .text {
    padding-block: clamp(48px, 6vw, 80px) 0;
    max-width: 920px;
  }
  .plain .text {
    padding-top: clamp(56px, 7vw, 96px);
  }
  .text :global(h1),
  .text :global(h2) {
    margin-bottom: 20px;
  }
  .lead {
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    line-height: 1.75;
    color: var(--muted);
    margin: 0 auto;
    max-width: 780px;
  }
  /* Long intros read better left-aligned; short ones stay centred under the heading. */
  .lead.long {
    text-align: left;
    max-width: 720px;
  }
</style>
