---
import Buttons from '../Buttons.astro'
import Img from '../Img.astro'
import {brandify} from '../../lib/utils'
import type {Img as Image, Link} from '../../lib/types'

interface Props {
  icon?: Image
  heading?: string
  intro?: string
  buttons?: Link[]
  tone?: string
}
const {icon, heading, intro, buttons, tone = 'peach'} = Astro.props
// Turn a bare email address in the intro into a link.
const introHtml = (intro || '')
  .replace(/[&<>]/g, (c) => ({'&': '&amp;', '<': '&lt;', '>': '&gt;'})[c]!)
  .replace(/([\w.+-]+@[\w-]+\.[\w.]+)/g, '<a href="mailto:$1">$1</a>')
---

<section class:list={['section cta', `tone-${tone}`]}>
  <div class="container">
    <div class="box">
      {icon?.url && <Img image={icon} width={170} class="icon" />}
      {heading && <h2 set:html={brandify(heading)} />}
      {intro && <p set:html={introHtml} />}
      <Buttons buttons={buttons} center />
    </div>
  </div>
</section>

<style>
  .cta {
    padding-block: clamp(48px, 7vw, 88px);
  }
  .box :global(.icon) {
    display: block;
    width: 150px;
    height: auto;
    margin: 0 auto 18px;
  }
  .box {
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
  }
  h2 {
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    margin-bottom: 10px;
  }
  p {
    margin: 0;
  }
</style>
