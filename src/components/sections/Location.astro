---
import Img from '../Img.astro'
import {brandify} from '../../lib/utils'
import {renderRichText} from '../../lib/portableText'
import type {Img as ImgT, RichText} from '../../lib/types'

interface Props {
  heading?: string
  intro?: string
  videoUrl?: string
  directions?: RichText
  directionsImage?: ImgT
  mapQuery?: string
}
const {heading, intro, videoUrl, directions, directionsImage, mapQuery = 'Tapijnkazerne 11, Maastricht'} = Astro.props
// OpenStreetMap: no cookies, no tracking, no API key.
// Tapijnkazerne 11 (OpenStreetMap node 12787193084)
const bbox = '5.6821,50.8407,5.6902,50.8447'
const marker = '50.84271,5.68616'
const mapSrc = `https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik&marker=${marker}`
const routeHref = `https://www.openstreetmap.org/directions?to=${encodeURIComponent(mapQuery)}`
const googleHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapQuery)}`
---

<section class="section">
  <div class="container">
    {
      (heading || intro) && (
        <div class="section-head">
          {heading && <h2 set:html={brandify(heading)} />}
          {intro && <p>{intro}</p>}
        </div>
      )
    }
    <div class="split">
      {
        videoUrl && (
          <figure class="video">
            <video src={videoUrl} controls preload="metadata" playsinline />
            <figcaption>The route from the main entrance to the DEXLab</figcaption>
          </figure>
        )
      }
      <div class="map">
        <iframe src={mapSrc} title={`Map: ${mapQuery}`} loading="lazy"></iframe>
        <p class="map-links">
          <strong>{mapQuery}</strong>
          <a href={googleHref} target="_blank" rel="noopener">Open in Google Maps ↗</a>
          <a href={routeHref} target="_blank" rel="noopener">Plan a route ↗</a>
        </p>
      </div>
    </div>
    <div class="split directions">
      <div class="prose" set:html={renderRichText(directions)} />
      {directionsImage?.url && <Img image={directionsImage} width={900} fit="max" class="campus" />}
    </div>
  </div>
</section>

<style>
  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    align-items: start;
  }
  .directions {
    margin-top: 56px;
    align-items: center;
  }
  figure {
    margin: 0;
  }
  video {
    width: 100%;
    border-radius: 0;
    background: var(--navy);
    box-shadow: none;
    aspect-ratio: 16 / 9;
  }
  figcaption {
    font-size: 0.88rem;
    color: var(--muted);
    margin-top: 8px;
  }
  .map iframe {
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }
  .map-links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    font-size: 0.92rem;
    margin-top: 10px;
  }
  .campus {
    border-radius: 0;
    box-shadow: none;
    width: 100%;
  }
  @media (max-width: 860px) {
    .split {
      grid-template-columns: 1fr;
    }
  }
</style>
