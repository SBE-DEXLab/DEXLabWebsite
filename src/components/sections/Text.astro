---
import YouTube from '../YouTube.astro'
import Img from '../Img.astro'
import Buttons from '../Buttons.astro'
import {brandify, youtubeId} from '../../lib/utils'
import {renderRichText} from '../../lib/portableText'
import type {Img as ImgT, Link, RichText} from '../../lib/types'

interface Props {
  anchor?: string
  heading?: string
  body?: RichText
  image?: ImgT
  imagePosition?: 'left' | 'right'
  video?: string
  buttons?: Link[]
  tone?: string
  centered?: boolean
}
// As on the old site: with a "Light grey" background the text sits in a grey panel next to the photo,
// otherwise text and photo sit side by side on white.
const {anchor, heading, body, image, imagePosition = 'right', video, buttons, tone = 'default', centered} = Astro.props
const yt = youtubeId(video)
const hasMedia = Boolean(yt || image?.url)
const panel = tone === 'muted' && hasMedia
---

<section id={anchor} class:list={['section', panel ? 'tone-default' : `tone-${tone}`]}>
  <div class:list={['container', {split: hasMedia, reverse: imagePosition === 'left', solo: !hasMedia, center: centered}]}>
    <div class:list={['copy', {panel}]}>
      {heading && <h2 set:html={brandify(heading)} />}
      <div class="prose" set:html={renderRichText(body)} />
      <Buttons buttons={buttons} center={centered} />
    </div>
    {
      hasMedia && (
        <div class="media">
          {yt ? (
            <YouTube id={yt} title={heading} />
          ) : (
            <Img image={image} width={640} sizes="(min-width: 980px) 480px, 100vw" fit="max" />
          )}
        </div>
      )
    }
  </div>
</section>

<style>
  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(20px, 4vw, 48px);
    align-items: center;
  }
  .split.reverse .media {
    order: -1;
  }
  .solo .copy {
    max-width: 780px;
    margin-inline: auto;
  }
  .center .copy {
    text-align: center;
  }
  .copy h2 {
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
  }
  .panel {
    background: var(--grey);
    padding: clamp(32px, 5vw, 56px);
    align-self: stretch;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .panel :global(p) {
    font-size: 1.05rem;
  }
  /* Bold everywhere means nothing stands out: only the opening paragraph keeps its emphasis. */
  .panel :global(p + p strong) {
    font-weight: inherit;
  }
  .media :global(img) {
    width: 100%;
    border-radius: var(--radius);
  }
  /* pictures beside a grey panel keep their own proportions (no cropping of graphics) */
  .split:has(.panel) {
    gap: 24px;
    align-items: center;
  }
  @media (max-width: 820px) {
    .split {
      grid-template-columns: 1fr;
    }
    .split.reverse .media {
      order: 0;
    }
  }
</style>
