---
import {brandify} from '../../lib/utils'
import {getSettings} from '../../lib/queries'
import SocialIcon from '../SocialIcon.astro'

interface Props {
  heading?: string
  intro?: string
  showDepartment?: boolean
}
const {heading, intro, showDepartment = true} = Astro.props
const settings = await getSettings()
---

<section class="section">
  <div class="container">
    <div class="details">
      {
        settings?.email && (
          <>
            <h3>Email us:</h3>
            <p><a href={`mailto:${settings.email}`}>{settings.email}</a></p>
          </>
        )
      }
      <h3>Social Media</h3>
      <p class="socials">
        {
          settings?.socials?.map((s) => (
            <a href={s.url} target="_blank" rel="noopener" aria-label={s.platform}>
              <SocialIcon platform={s.platform} />
            </a>
          ))
        }
      </p>
      <a class="btn" href="/visit-us">Visit Us</a>
    </div>
    <hr />
    {heading && <h2 class="form-title" set:html={brandify(heading)} />}
    {intro && <p class="intro">{intro}</p>}
    <div class="panel form-panel">
      <form class="form" name="contact" method="POST" action="/thanks/?form=contact" data-netlify="true" netlify-honeypot="company">
                  <input type="hidden" name="form-name" value="contact" />
      <p class="hp"><label>Leave this empty <input name="company" tabindex="-1" autocomplete="off" /></label></p>
      <div class="row">
        <div class="field"><label for="c-first">First name</label><input id="c-first" name="first-name" autocomplete="given-name" /></div>
        <div class="field"><label for="c-last">Last name</label><input id="c-last" name="last-name" autocomplete="family-name" /></div>
      </div>
      <div class="row">
        <div class="field"><label for="c-email">Email *</label><input id="c-email" name="email" type="email" required autocomplete="email" /></div>
        <div class="field"><label for="c-phone">Phone</label><input id="c-phone" name="phone" type="tel" autocomplete="tel" /></div>
      </div>
      {
        showDepartment && (
          <div class="row">
            <div class="field"><label for="c-position">Position</label><input id="c-position" name="position" autocomplete="organization-title" /></div>
            <div class="field"><label for="c-dept">SBE department or organisation</label><input id="c-dept" name="department" autocomplete="organization" /></div>
          </div>
        )
      }
      <div class="field">
        <label for="c-topic">What is it about?</label>
        <select id="c-topic" name="topic">
          <option>General question</option>
          <option>Booking the lab or equipment</option>
          <option>Workshop for my team or company</option>
          <option>Research collaboration</option>
          <option>Thesis or internship</option>
          <option>Media or press</option>
        </select>
      </div>
      <div class="field"><label for="c-subject">Subject</label><input id="c-subject" name="subject" /></div>
      <div class="field"><label for="c-msg">Message *</label><textarea id="c-msg" name="message" rows="6" required></textarea></div>
      <label class="check">
        <input type="checkbox" name="consent" value="yes" required />
        <span>I agree that DEXLab uses my details to answer my message, as described in the <a href="/privacy">privacy statement</a>.</span>
      </label>
      <button class="btn submit" type="submit">Submit</button>
    </form>
    </div>
  </div>
</section>

<style>
  .details {
    text-align: center;
  }
  .details h3 {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 1.05rem;
    margin: 18px 0 4px;
  }
  .details p {
    margin: 0;
  }
  .socials {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-bottom: 20px !important;
  }
  .socials a {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 4px;
    background: var(--navy);
    color: #fff;
  }
  .details .btn {
    margin-top: 14px;
  }
  hr {
    border: 0;
    border-top: 1px solid var(--navy);
    margin: 40px 0 28px;
  }
  .form-title {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 1.15rem;
    text-align: center;
    margin: 0 0 6px;
  }
  .intro {
    text-align: center;
    margin: 0 auto 20px;
    max-width: 420px;
  }
  .form-panel {
    max-width: 640px;
    margin: 0 auto;
    padding: clamp(20px, 4vw, 40px) clamp(20px, 6vw, 64px);
  }
  form {
    display: grid;
    gap: 16px;
  }
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }
  .submit {
    justify-self: center;
  }
  @media (max-width: 560px) {
    .row {
      grid-template-columns: 1fr;
    }
  }
</style>
