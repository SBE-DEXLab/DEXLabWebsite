---
import Img from '../Img.astro'
import {brandify, isExternal} from '../../lib/utils'
import type {Img as ImgT, Link} from '../../lib/types'

interface Card {
  _key: string
  title: string
  text?: string
  image?: ImgT
  link?: Link
}
interface Props {
  anchor?: string
  heading?: string
  intro?: string
  style?: 'icon' | 'photo' | 'steps'
  columns?: number
  items?: Card[]
  tone?: string
}
const {anchor, heading, intro, style = 'icon', columns = 3, items = [], tone = 'default'} = Astro.props
const ext = (href?: string) => (isExternal(href) ? {target: '_blank', rel: 'noopener'} : {})
---

<section id={anchor} class:list={['section', `tone-${tone}`]}>
  <div class="container">
    {
      (heading || intro) && (
        <div class="section-head">
          {heading && <h2 set:html={brandify(heading)} />}
          {intro && <p>{intro}</p>}
        </div>
      )
    }
    <div class:list={['grid', `style-${style}`]} style={`--cols: ${columns}`}>
      {
        items.map((item, i) => (
          <article class="card lift">
            {style === 'photo' && item.image?.url && (
              <div class="card-media">
                <Img image={item.image} width={560} height={380} sizes="(min-width: 1000px) 380px, (min-width: 640px) 50vw, 100vw" />
              </div>
            )}
            <div class="card-body">
              {style === 'icon' && item.image?.url && (
                <div class="icon">
                  <Img image={item.image} width={160} fit="max" alt="" />
                </div>
              )}
              {style === 'steps' && <span class="step">{String(i + 1).padStart(2, '0')}</span>}
              <h3 set:html={brandify(item.title)} />
              {item.text && <p>{item.text}</p>}
              {item.link?.href && (
                <a class="text-link" href={item.link.href} {...ext(item.link.href)}>
                  {item.link.label} <span aria-hidden="true">→</span>
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .icon {
    width: 76px;
    height: 76px;
    border-radius: 20px;
    background: var(--peach-2);
    display: grid;
    place-items: center;
    margin-bottom: 6px;
  }
  .icon :global(img) {
    width: 52px;
    height: 52px;
    object-fit: contain;
  }
  .style-icon .card {
    border-top: 4px solid transparent;
    background:
      linear-gradient(#fff, #fff) padding-box,
      linear-gradient(90deg, var(--blue), var(--orange)) border-box;
  }
  .step {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 2.6rem;
    line-height: 1;
    background: linear-gradient(135deg, var(--blue), var(--orange));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .style-photo .card-media {
    aspect-ratio: 3 / 2;
  }
  .tone-blue .card :global(h3),
  .tone-navy .card :global(h3) {
    color: var(--navy);
  }
</style>
