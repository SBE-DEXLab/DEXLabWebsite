---
import {brandify} from '../../lib/utils'

interface Props {
  heading?: string
  intro?: string
  items?: string[]
  tone?: string
}
const {heading, intro, items = [], tone = 'default'} = Astro.props
---

<section class:list={['section', `tone-${tone}`]}>
  <div class="container">
    {
      (heading || intro) && (
        <div class="section-head">
          {heading && <h2 set:html={brandify(heading)} />}
          {intro && <p>{intro}</p>}
        </div>
      )
    }
    <ul class="pills">
      {items.map((p) => <li>{p}</li>)}
    </ul>
  </div>
</section>

<style>
  .pills {
    list-style: none;
    padding: 0;
    margin: 0 auto;
    max-width: 960px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
  .pills li {
    flex: 0 0 calc(25% - 12px);
    padding: 6px 4px;
    font: 700 1.05rem var(--font-head);
    color: var(--navy);
    text-align: center;
  }
  @media (max-width: 700px) {
    .pills li {
      flex-basis: calc(50% - 12px);
    }
  }
</style>
