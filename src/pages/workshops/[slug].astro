---
import Base from '../../layouts/Base.astro'
import Img from '../../components/Img.astro'
import Hero from '../../components/sections/Hero.astro'
import {getWorkshops, getWorkshop, getSettings} from '../../lib/queries'
import {renderRichText} from '../../lib/portableText'

export async function getStaticPaths() {
  const workshops = await getWorkshops()
  return workshops.filter((w) => !w.externalOnly).map((w) => ({params: {slug: w.slug}}))
}

const [w, settings] = await Promise.all([getWorkshop(Astro.params.slug!), getSettings()])
if (!w) return Astro.redirect('/404')
const email = settings?.email || 'sbe-dexlab@maastrichtuniversity.nl'
const mailto = `mailto:${email}?subject=${encodeURIComponent(w.contactSubject || w.title)}`
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: w.title,
  description: w.intro || w.summary,
  provider: {'@type': 'Organization', name: 'DEXLab, Maastricht University', sameAs: Astro.site?.href},
}
---

<Base title={w.seo?.title || w.title} description={w.seo?.description || w.summary} image={w.seo?.image || w.heroImage} jsonLd={ld}>
  <Hero heading={w.title} subheading={w.intro} image={w.heroImage} layout="banner" />

  {
    w.gallery?.length ? (
      <section class="container gallery">
        {w.gallery.map((img, i) => (
          <Img image={img} width={i === 0 ? 980 : 600} height={i === 0 ? 301 : 301} sizes="(min-width: 980px) 900px, 100vw" class={i === 0 ? 'wide-img' : undefined} />
        ))}
      </section>
    ) : null
  }

  {
    w.facts?.length ? (
      <section class="section tone-muted">
        <div class="container">
          <h2 class="center-h">Highlights</h2>
          <ul class="facts">
            {w.facts.map((f) => (
              <li>
                <strong>{f.value}</strong>
                {f.text && <span>{f.text}</span>}
              </li>
            ))}
          </ul>
        </div>
      </section>
    ) : null
  }

  {
    w.technologies?.length ? (
      <section class="section">
        <div class="container">
          <h2 class="center-h">The Technologies</h2>
          <ul class="tech">
            {w.technologies.map((t) => (
              <li>
                <Img image={t.image} width={300} height={300} alt="" />
                <span>{t.name}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    ) : null
  }

  <section class="section details">
    <div class="container">
      {
        w.outcomes?.length ? (
          <>
            <h2>{w.outcomesHeading || 'What does the workshop hold for you?'}</h2>
            <ul class="outcomes">
              {w.outcomes.map((o) => (
                <li>{o}</li>
              ))}
            </ul>
          </>
        ) : null
      }
      <div class="prose" set:html={renderRichText(w.body)} />
      <p class="reach">
        If this sounds interesting, reach out to us at <a href={mailto}>{email}</a> or simply click the button below:
      </p>
      <a class="btn blue" href={mailto}>Contact us</a>
    </div>
  </section>
</Base>

<style>
  .gallery {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: 16px;
    padding-block: clamp(40px, 5vw, 64px) 8px;
  }
  .gallery :global(img) {
    width: 100%;
    height: 100%;
    max-height: 340px;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .gallery :global(.wide-img) {
    grid-column: 1 / -1;
  }
  .center-h {
    text-align: center;
    margin-bottom: 28px;
  }
  .facts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 20px;
    text-align: center;
  }
  .facts li {
    display: grid;
    align-content: center;
    background: #fff;
    border-radius: var(--radius);
    padding: 28px 22px;
    box-shadow: var(--shadow);
  }
  .facts strong {
    display: block;
    font: 700 1.25rem var(--font-head);
    color: var(--navy);
    margin-bottom: 8px;
  }
  .facts span {
    font-size: 0.95rem;
    color: var(--muted);
  }
  .tech {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 1000px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 28px 40px;
  }
  .tech li {
    width: 200px;
  }
  .tech li {
    text-align: center;
  }
  .tech :global(img) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 50%;
    box-shadow: var(--shadow);
  }
  .tech span {
    display: block;
    margin-top: 14px;
    font: 700 1rem var(--font-head);
    color: var(--navy);
  }
  .details .container {
    max-width: 780px;
  }
  .details h2 {
    font-size: clamp(1.3rem, 2.4vw, 1.7rem);
  }
  .outcomes {
    margin: 0 0 1.4em;
    padding-left: 1.2em;
  }
  .outcomes li {
    margin-bottom: 4px;
  }
  .reach {
    margin-top: 1.6em;
  }
  @media (max-width: 640px) {
    .gallery {
      grid-template-columns: 1fr;
    }
    .tech li {
      width: 42%;
    }
  }
</style>
