---
import Base from '../../layouts/Base.astro'
import Img from '../../components/Img.astro'
import Hero from '../../components/sections/Hero.astro'
import {getWorkshops, getWorkshop, getSettings} from '../../lib/queries'
import {renderRichText} from '../../lib/portableText'

export async function getStaticPaths() {
  const workshops = await getWorkshops()
  return workshops.filter((w) => !w.externalOnly).map((w) => ({params: {slug: w.slug}}))
}

const [w, settings] = await Promise.all([getWorkshop(Astro.params.slug!), getSettings()])
if (!w) return Astro.redirect('/404')
const email = settings?.email || 'sbe-dexlab@maastrichtuniversity.nl'
const mailto = `mailto:${email}?subject=${encodeURIComponent(w.contactSubject || w.title)}`
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: w.title,
  description: w.intro || w.summary,
  provider: {'@type': 'Organization', name: 'DEXLab, Maastricht University', sameAs: Astro.site?.href},
}
---

<Base title={w.seo?.title || w.title} description={w.seo?.description || w.summary} image={w.seo?.image || w.heroImage} jsonLd={ld}>
  <Hero
    heading={w.title}
    eyebrow="DEXLab workshop"
    subheading={w.intro}
    image={w.heroImage}
    layout="banner"
    buttons={[{label: 'Request this workshop', href: mailto}]}
  />

  {
    w.facts?.length ? (
      <section class="section facts-wrap">
        <div class="container">
          <ul class="facts">
            {w.facts.map((f) => (
              <li>
                <strong>{f.value}</strong>
                {f.label && <span class="label">{f.label}</span>}
                {f.text && <span class="text">{f.text}</span>}
              </li>
            ))}
          </ul>
        </div>
      </section>
    ) : null
  }

  {
    w.gallery?.length ? (
      <section class="gallery container">
        {w.gallery.map((img, i) => (
          <Img image={img} width={i === 0 ? 780 : 480} height={420} sizes="(min-width: 860px) 50vw, 100vw" />
        ))}
      </section>
    ) : null
  }

  {
    w.technologies?.length ? (
      <section class="section">
        <div class="container">
          <div class="section-head">
            <h2>The technologies</h2>
          </div>
          <ul class="tech" style={`--n: ${w.technologies.length}`}>
            {w.technologies.map((t) => (
              <li>
                <div class="tech-img">
                  <Img image={t.image} width={360} height={380} alt={t.name} />
                  <span class="abbr">{t.short}</span>
                </div>
                <h3>{t.name}</h3>
              </li>
            ))}
          </ul>
        </div>
      </section>
    ) : null
  }

  {
    (w.outcomes?.length || w.body?.length) && (
      <section class="section tone-muted">
        <div class="container narrow-content">
          {w.outcomes?.length ? (
            <>
              <h2 class="accent-rule">{w.outcomesHeading || 'What does the workshop hold for you?'}</h2>
              <ol class="outcomes">
                {w.outcomes.map((o) => (
                  <li>{o}</li>
                ))}
              </ol>
            </>
          ) : null}
          <div class="prose" set:html={renderRichText(w.body)} />
        </div>
      </section>
    )
  }

  <section class="section tone-blue request">
    <div class="container">
      <h2>Interested? Let us plan your session.</h2>
      <p>Reach out to <a href={mailto}>{email}</a> or use the button below. We reply within a few working days.</p>
      <div class="btn-row center">
        <a class="btn" href={mailto}>Contact us <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn secondary" href="/contact">Use the contact form</a>
      </div>
    </div>
  </section>

  {
    w.others?.length ? (
      <section class="section">
        <div class="container">
          <div class="section-head">
            <h2>Other workshops</h2>
          </div>
          <div class="grid" style="--cols: 4">
            {w.others.map((o) => (
              <a class="card other" href={`/workshops/${o.slug}`}>
                <div class="card-media">
                  <Img image={o.cardImage} width={400} height={300} sizes="(min-width: 1000px) 280px, 50vw" />
                </div>
                <div class="card-body">
                  <h3>{o.title}</h3>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    ) : null
  }
</Base>

<style>
  .facts-wrap {
    padding-block: 48px 24px;
  }
  .facts {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
  }
  .facts li {
    background: var(--peach-2);
    border-radius: var(--radius);
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    border-top: 4px solid var(--orange);
  }
  .facts li:nth-child(even) {
    border-top-color: var(--blue);
  }
  .facts strong {
    font: 800 1.3rem var(--font-head);
    color: var(--navy);
  }
  .facts .text {
    color: var(--muted);
    font-size: 0.95rem;
  }
  .gallery {
    display: grid;
    grid-template-columns: 2fr 1.2fr 1fr;
    gap: 16px;
    padding-block: 24px;
  }
  .gallery :global(img) {
    width: 100%;
    height: 300px;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .tech {
    list-style: none;
    padding: 0;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 260px));
    justify-content: center;
    gap: 24px;
    text-align: center;
  }
  .tech-img {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  .tech-img :global(img) {
    width: 100%;
    aspect-ratio: 18 / 19;
    object-fit: cover;
  }
  .abbr {
    position: absolute;
    left: 14px;
    bottom: 14px;
    font: 800 1.8rem var(--font-head);
    color: #fff;
    background: var(--navy);
    padding: 2px 14px;
    border-radius: 10px;
  }
  .tech li:nth-child(even) .abbr {
    background: var(--orange);
  }
  .tech h3 {
    margin-top: 14px;
  }
  .narrow-content {
    max-width: 820px;
  }
  .outcomes {
    list-style: none;
    padding: 0;
    margin: 0 0 40px;
    counter-reset: o;
    display: grid;
    gap: 12px;
  }
  .outcomes li {
    counter-increment: o;
    display: flex;
    gap: 16px;
    align-items: center;
    background: #fff;
    padding: 16px 20px;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow);
    font-weight: 600;
    color: var(--navy);
  }
  .outcomes li::before {
    content: counter(o);
    flex: none;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--blue);
    color: #fff;
    font-weight: 800;
  }
  .request {
    text-align: center;
  }
  .request p {
    max-width: 640px;
    margin-inline: auto;
  }
  .other .card-media {
    aspect-ratio: 4 / 3;
  }
  .other h3 {
    font-size: 1.05rem;
  }
  @media (max-width: 860px) {
    .gallery {
      grid-template-columns: 1fr 1fr;
    }
    .gallery :global(img:first-child) {
      grid-column: 1 / -1;
    }
    .tech {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
